# these functions are appended to an include file that is sent to gtkdialog and allows for functions to be used within gtkdialog actions

# functions

_check_ffmpeg_install(){
    echo "Using ffmpeg at ${FFMPEG_BIN}"
    echo
    if [ ! -f "${FFMPEG_BIN}" ] ; then
        echo "${FFMPEG_BIN} is not found. Please install ffmpeg-ma via:"
        echo "    brew install mediaarea/mediaarea/ffmpeg-ma"
        echo "Or install a version of ffmpeg that is compiled with decklink support if you wish to use that input."
        echo
    fi
    if [ ! -f "${FFPLAY_BIN}" ] ; then
        echo "${FFPLAY_BIN} is not found."
        echo
    fi
    if [ ! -f "${FFPROBE_BIN}" ] ; then
        echo "${FFPROBE_BIN} is not found."
        echo
    fi
    echo
    FFMPEG_V="$("${FFMPEG_BIN}" -version 2>&1)"
    echo "FFmpeg configuration: ${FFMPEG_V}"
    echo
    if [ "$(echo "${FFMPEG_V}" | grep "Library not loaded" >/dev/null)" ] ; then
        echo "Please reinstall 'ffmpeg-ma':"
        echo "    brew reinstall mediaarea/mediaarea/ffmpeg-ma"
        echo "Or install a version of ffmpeg that is compiled with decklink support if you wish to use that input."
        echo "Exiting."
        exit 1
    fi
    if [ -z "$("${FFMPEG_BIN}" -nostdin -v 0 -sources decklink)" ] ; then
        echo "vrecord is set to use a decklink input but ${FFMPEG_BIN} does not appear to support decklink inputs."
        echo "Please review installation and troubleshooting information for vrecord or install ffmpeg-ma."
        exit 1
    fi
}

# Video Preview tab: launch a background preview of the decklink input that
# writes a regularly updated JPEG for the settings window and, when the relay
# option is on, sends the feed to the selected device's output through the
# Blackmagic SDK (SDI, HDMI, or analogue, depending on the card's connectors)
_start_video_preview(){
    if [ -f "${VRECORD_PREVIEW_PID_TMP}" ] && kill -0 "$(cat "${VRECORD_PREVIEW_PID_TMP}")" 2>/dev/null ; then
        echo "preview already running" > "${VRECORD_PREVIEW_STATUS_TMP}"
        return 0
    fi
    if [ -f "${VRECORD_RECORD_PID_TMP}" ] && kill -0 "$(cat "${VRECORD_RECORD_PID_TMP}")" 2>/dev/null ; then
        echo "recording in progress - stop it first" > "${VRECORD_PREVIEW_STATUS_TMP}"
        return 1
    fi
    if [ -z "${DECKLINK_INPUT_CHOICE}" ] ; then
        echo "select a video card on the Decklink tab first" > "${VRECORD_PREVIEW_STATUS_TMP}"
        return 1
    fi
    case "${STANDARD_CHOICE}" in
        "NTSC") PREVIEW_FORMAT="ntsc" ;;
        "PAL")  PREVIEW_FORMAT="pal" ;;
        "")     echo "select a standard on the Decklink tab first" > "${VRECORD_PREVIEW_STATUS_TMP}" ; return 1 ;;
        *)      PREVIEW_FORMAT="$(echo "${STANDARD_CHOICE}" | cut -d ' ' -f1)" ;;
    esac
    case "${VIDEO_INPUT_CHOICE}" in
        "Composite") PREVIEW_VINPUT="composite" ;;
        "Component") PREVIEW_VINPUT="component" ;;
        "S-Video")   PREVIEW_VINPUT="s_video" ;;
        *)           PREVIEW_VINPUT="sdi" ;;
    esac
    # build the ffmpeg arguments as positional parameters so device names with spaces stay intact
    set -- "${FFMPEG_BIN}" -nostdin -nostats -loglevel error -format_code "${PREVIEW_FORMAT}" -video_input "${PREVIEW_VINPUT}"
    if [ "${PREVIEW_RELAY_CHOICE}" = "true" ] ; then
        case "${AUDIO_INPUT_CHOICE}" in
            "SDI Embedded Audio")      PREVIEW_AINPUT="embedded" ;;
            "Digital Audio (AES/EBU)") PREVIEW_AINPUT="aes_ebu" ;;
            *)                         PREVIEW_AINPUT="analog" ;;
        esac
        set -- "$@" -audio_input "${PREVIEW_AINPUT}"
    fi
    set -- "$@" -f decklink -i "${DECKLINK_INPUT_CHOICE}"
    set -- "$@" -map 0:v -vf scale=640:-2 -r 5 -f image2 -update 1 "${VRECORD_PREVIEW_TMP}"
    if [ "${PREVIEW_RELAY_CHOICE}" = "true" ] ; then
        PREVIEW_RELAY_DEV="${DECKLINK_INPUT_CHOICE}"
        if [ -n "${PREVIEW_RELAY_DEV_CHOICE}" ] ; then
            PREVIEW_RELAY_DEV="${PREVIEW_RELAY_DEV_CHOICE}"
        fi
        set -- "$@" -map 0:v -map 0:a -c:v v210 -c:a pcm_s16le -ar 48000 -ac 2 -f decklink "${PREVIEW_RELAY_DEV}"
    fi
    rm -f "${VRECORD_PREVIEW_TMP}"
    echo "starting preview..." > "${VRECORD_PREVIEW_STATUS_TMP}"
    "$@" > "${VRECORD_PREVIEW_LOG_TMP}" 2>&1 &
    echo $! > "${VRECORD_PREVIEW_PID_TMP}"
}

# Video Preview tab: play a media file out to the selected device's output
# through the Blackmagic SDK, converting on the fly to the output mode of the
# selected standard (video size, frame rate, and field order)
_start_file_playback(){
    if [ -f "${VRECORD_FILEPLAY_PID_TMP}" ] && kill -0 "$(cat "${VRECORD_FILEPLAY_PID_TMP}")" 2>/dev/null ; then
        echo "file playback already running" > "${VRECORD_FILEPLAY_STATUS_TMP}"
        return 0
    fi
    if [ -f "${VRECORD_RECORD_PID_TMP}" ] && kill -0 "$(cat "${VRECORD_RECORD_PID_TMP}")" 2>/dev/null ; then
        echo "recording in progress - stop it first" > "${VRECORD_FILEPLAY_STATUS_TMP}"
        return 1
    fi
    if [ -z "${VRECORD_PLAY_FILE}" ] ; then
        echo "select a file to play first" > "${VRECORD_FILEPLAY_STATUS_TMP}"
        return 1
    fi
    if [ ! -f "${VRECORD_PLAY_FILE}" ] ; then
        echo "file not found: ${VRECORD_PLAY_FILE}" > "${VRECORD_FILEPLAY_STATUS_TMP}"
        return 1
    fi
    FILEPLAY_DEV="${PREVIEW_RELAY_DEV_CHOICE:-${DECKLINK_INPUT_CHOICE}}"
    if [ -z "${FILEPLAY_DEV}" ] ; then
        echo "select an output device first" > "${VRECORD_FILEPLAY_STATUS_TMP}"
        return 1
    fi
    # the file is converted to the output mode of the selected standard (matching the capture settings)
    case "${STANDARD_CHOICE}" in
        "NTSC") FP_SIZE="720:486" ; FP_RATE="30000/1001" ; FP_FIELD="bff" ;;
        "PAL")  FP_SIZE="720:576" ; FP_RATE="25/1" ; FP_FIELD="tff" ;;
        "23ps - 1080p23.98") FP_SIZE="1920:1080" ; FP_RATE="24000/1001" ; FP_FIELD="" ;;
        "24ps - 1080p24")    FP_SIZE="1920:1080" ; FP_RATE="24/1" ; FP_FIELD="" ;;
        "Hp25 - 1080p25")    FP_SIZE="1920:1080" ; FP_RATE="25/1" ; FP_FIELD="" ;;
        "Hp29 - 1080p29.97") FP_SIZE="1920:1080" ; FP_RATE="30000/1001" ; FP_FIELD="" ;;
        "Hp30 - 1080p30")    FP_SIZE="1920:1080" ; FP_RATE="30/1" ; FP_FIELD="" ;;
        "Hi50 - 1080i50")    FP_SIZE="1920:1080" ; FP_RATE="25/1" ; FP_FIELD="tff" ;;
        "Hi59 - 1080i59.94") FP_SIZE="1920:1080" ; FP_RATE="30000/1001" ; FP_FIELD="tff" ;;
        "Hi60 - 1080i60")    FP_SIZE="1920:1080" ; FP_RATE="30/1" ; FP_FIELD="tff" ;;
        "hp50 - 720p50")     FP_SIZE="1280:720" ; FP_RATE="50/1" ; FP_FIELD="" ;;
        "hp59 - 720p59.94")  FP_SIZE="1280:720" ; FP_RATE="60000/1001" ; FP_FIELD="" ;;
        "hp60 - 720p60")     FP_SIZE="1280:720" ; FP_RATE="60/1" ; FP_FIELD="" ;;
        "")  echo "select a standard on the Decklink tab first" > "${VRECORD_FILEPLAY_STATUS_TMP}" ; return 1 ;;
        *)   echo "unsupported standard: ${STANDARD_CHOICE}" > "${VRECORD_FILEPLAY_STATUS_TMP}" ; return 1 ;;
    esac
    FP_VF="scale=${FP_SIZE},fps=${FP_RATE}"
    if [ -n "${FP_FIELD}" ] ; then
        FP_VF="${FP_VF},setfield=${FP_FIELD}"
    fi
    # file duration, used by the scrub bar and the position display
    FP_PROBE="${FFPROBE_BIN}"
    if [ -z "${FP_PROBE}" ] || [ ! -x "${FP_PROBE}" ] ; then
        FP_PROBE="$(dirname "${FFMPEG_BIN}")/ffprobe-ma"
    fi
    if [ -z "${FP_PROBE}" ] || [ ! -x "${FP_PROBE}" ] ; then
        FP_PROBE="$(command -v ffprobe 2>/dev/null)"
    fi
    FP_DUR="$(${FP_PROBE} -v error -show_entries format=duration -of csv=p=0 "${VRECORD_PLAY_FILE}" 2>/dev/null)"
    echo "${FP_DUR}" > "${VRECORD_FILEPLAY_DUR_TMP}"
    # resume from a saved position if it belongs to this file and is not the end
    FP_RESUME=""
    FP_POS="$(cat "${VRECORD_PLAY_POS_TMP}" 2>/dev/null)"
    if [ -n "${FP_POS}" ] && [ "$(echo "${FP_POS}" | cut -d'|' -f1)" = "${VRECORD_PLAY_FILE}" ] ; then
        FP_RESTIME="$(echo "${FP_POS}" | cut -d'|' -f2)"
        FP_RESSEC="$(echo "${FP_RESTIME}" | awk -F: '{ if (NF==3) print $1*3600+$2*60+$3 ; else print $1 }')"
        if [ -n "${FP_DUR}" ] && [ "$(awk -v a="${FP_RESSEC}" -v b="${FP_DUR}" 'BEGIN { print (a+0 >= b-0.05) ? 1 : 0 }')" = "1" ] ; then
            rm -f "${VRECORD_PLAY_POS_TMP}"
        else
            FP_RESUME="${FP_RESTIME}"
        fi
    fi
    rm -f "${VRECORD_FILEPLAY_IMG_TMP}"
    set -- "${FFMPEG_BIN}" -nostdin -nostats -loglevel error -stats -stats_period 0.033 -re
    if [ -n "${FP_RESUME}" ] ; then
        set -- "$@" -ss "${FP_RESUME}"
    fi
    set -- "$@" -i "${VRECORD_PLAY_FILE}"
    # small preview of the outgoing file for the output side of the tab
    set -- "$@" -map 0:v -vf scale=320:-2 -r 5 -f image2 -update 1 "${VRECORD_FILEPLAY_IMG_TMP}"
    # converted feed to the device output
    set -- "$@" -map 0:v -map "0:a?" -vf "${FP_VF}" -c:v v210 -c:a pcm_s16le -ar 48000 -ac 2 -f decklink "${FILEPLAY_DEV}"
    echo "playing ${VRECORD_PLAY_FILE}${FP_RESUME:+ from ${FP_RESUME}}" > "${VRECORD_FILEPLAY_STATUS_TMP}"
    "$@" > "${VRECORD_FILEPLAY_LOG_TMP}" 2>&1 &
    echo $! > "${VRECORD_FILEPLAY_PID_TMP}"
}

# Video Preview tab: pause file playback, keeping the position for a later resume
_pause_file_playback(){
    FP_PAUSETIME=""
    FP_RUNNING="false"
    if [ -f "${VRECORD_FILEPLAY_PID_TMP}" ] && kill -0 "$(cat "${VRECORD_FILEPLAY_PID_TMP}")" 2>/dev/null ; then
        FP_RUNNING="true"
        # parse the freshest stats line so the pause lands on the frame being shown
        FP_PAUSETIME="$(tail -c 4096 "${VRECORD_FILEPLAY_LOG_TMP}" 2>/dev/null | grep -o 'time=[0-9:.]*' | tail -n 1 | cut -d= -f2)"
    fi
    if [ -z "${FP_PAUSETIME}" ] ; then
        FP_POS="$(cat "${VRECORD_PLAY_POS_TMP}" 2>/dev/null)"
        if [ -n "${FP_POS}" ] && [ "$(echo "${FP_POS}" | cut -d'|' -f1)" = "${VRECORD_PLAY_FILE}" ] ; then
            FP_PAUSETIME="$(echo "${FP_POS}" | cut -d'|' -f2)"
        fi
    fi
    if [ "${FP_RUNNING}" != "true" ] && [ -z "${FP_PAUSETIME}" ] ; then
        echo "not playing" > "${VRECORD_FILEPLAY_STATUS_TMP}"
        return 0
    fi
    _stop_bg_process "${VRECORD_FILEPLAY_PID_TMP}" "${VRECORD_FILEPLAY_STATUS_TMP}"
    if [ -z "${FP_PAUSETIME}" ] ; then
        FP_PAUSETIME="00:00:00.00"
    fi
    echo "${VRECORD_PLAY_FILE}|${FP_PAUSETIME}" > "${VRECORD_PLAY_POS_TMP}"
    echo "paused at ${FP_PAUSETIME} - toggle Play to resume" > "${VRECORD_FILEPLAY_STATUS_TMP}"
}

# Video Preview tab: scrub bar handler - seeks the file playback to the scrub
# bar percentage of the file duration
_seek_file_playback(){
    FP_PCT="${FILEPLAY_SEEK}"
    if ! echo "${FP_PCT}" | grep -qE '^[0-9]+([.][0-9]+)?$' ; then
        return 1
    fi
    FP_DUR="$(cat "${VRECORD_FILEPLAY_DUR_TMP}" 2>/dev/null)"
    if [ -z "${FP_DUR}" ] ; then
        echo "duration unknown - cannot seek (play the file once first)" > "${VRECORD_FILEPLAY_STATUS_TMP}"
        return 1
    fi
    FP_SEC="$(awk -v d="${FP_DUR}" -v p="${FP_PCT}" 'BEGIN { printf "%.2f", d * p / 100 }')"
    FP_HMS="$(awk -v s="${FP_SEC}" 'BEGIN { printf "%02d:%02d:%06.3f", int(s/3600), int((s%3600)/60), s%60 }')"
    echo "${VRECORD_PLAY_FILE}|${FP_HMS}" > "${VRECORD_PLAY_POS_TMP}"
    if [ -f "${VRECORD_FILEPLAY_PID_TMP}" ] && kill -0 "$(cat "${VRECORD_FILEPLAY_PID_TMP}")" 2>/dev/null ; then
        _stop_bg_process "${VRECORD_FILEPLAY_PID_TMP}" "${VRECORD_FILEPLAY_STATUS_TMP}"
        _start_file_playback
    else
        echo "cued at ${FP_HMS} - toggle Play to start there" > "${VRECORD_FILEPLAY_STATUS_TMP}"
    fi
}

# Video Preview tab: start a recording in a separate vrecord process so the
# settings window stays open with its controls while capturing
_start_gui_recording(){
    if [ -f "${VRECORD_RECORD_PID_TMP}" ] && kill -0 "$(cat "${VRECORD_RECORD_PID_TMP}")" 2>/dev/null ; then
        echo "already recording" > "${VRECORD_RECORD_STATUS_TMP}"
        return 0
    fi
    if [ -z "${ID}" ] ; then
        echo "enter a Name of Recording first" > "${VRECORD_RECORD_STATUS_TMP}"
        return 1
    fi
    GUIREC_INPUT="${DEVICE_INPUT_CHOICE}"
    if [ "${GUIREC_INPUT}" = "4" ] ; then
        GUIREC_INPUT="${INPUT_CHOICE_MEM}"
    fi
    if [ -z "${GUIREC_INPUT}" ] || [ "${GUIREC_INPUT}" = "3" ] ; then
        echo "select an input on the Decklink, DV, or Audio tab first" > "${VRECORD_RECORD_STATUS_TMP}"
        return 1
    fi
    _stop_video_preview
    _stop_file_playback
    _update_config_file
    rm -f "${VRECORD_RECORD_LOG_TMP}"
    echo "starting recording..." > "${VRECORD_RECORD_STATUS_TMP}"
    "${VRECORD_BIN}" "${ID}" < /dev/null > "${VRECORD_RECORD_LOG_TMP}" 2>&1 &
    echo $! > "${VRECORD_RECORD_PID_TMP}"
}

# Video Preview tab: stop a recording started from the settings window by
# ending its playback window, so the recording process runs its post-processing
_stop_gui_recording(){
    if [ ! -f "${VRECORD_RECORD_PID_TMP}" ] ; then
        echo "not recording" > "${VRECORD_RECORD_STATUS_TMP}"
        return 0
    fi
    GUIREC_PID="$(cat "${VRECORD_RECORD_PID_TMP}")"
    if [ -n "${GUIREC_PID}" ] && kill -0 "${GUIREC_PID}" 2>/dev/null ; then
        echo "stopping recording..." > "${VRECORD_RECORD_STATUS_TMP}"
        # end the playback window first, like closing it in the classic flow
        GUIREC_PLAYER="$(pgrep -P "${GUIREC_PID}" ffplay-ma 2>/dev/null | head -n 1)"
        [ -z "${GUIREC_PLAYER}" ] && GUIREC_PLAYER="$(pgrep -P "${GUIREC_PID}" ffplay 2>/dev/null | head -n 1)"
        [ -z "${GUIREC_PLAYER}" ] && GUIREC_PLAYER="$(pgrep -P "${GUIREC_PID}" mpv 2>/dev/null | head -n 1)"
        if [ -n "${GUIREC_PLAYER}" ] ; then
            kill "${GUIREC_PLAYER}" 2>/dev/null
        fi
        # if the recorder is still running shortly after, end it too so the post-processing begins
        GUIREC_WAIT=0
        while [ "${GUIREC_WAIT}" -lt 30 ] && kill -0 "${GUIREC_PID}" 2>/dev/null ; do
            sleep 0.1
            GUIREC_WAIT=$(( GUIREC_WAIT + 1 ))
        done
        if kill -0 "${GUIREC_PID}" 2>/dev/null ; then
            GUIREC_FFMPEG="$(pgrep -P "${GUIREC_PID}" ffmpeg-ma 2>/dev/null | head -n 1)"
            [ -n "${GUIREC_FFMPEG}" ] && kill "${GUIREC_FFMPEG}" 2>/dev/null
        fi
    fi
    rm -f "${VRECORD_RECORD_PID_TMP}"
}

# Video Preview tab: keep the recording status line in sync with the recording process
_refresh_gui_recording_status(){
    if [ -f "${VRECORD_RECORD_PID_TMP}" ] ; then
        GUIREC_PID="$(cat "${VRECORD_RECORD_PID_TMP}")"
        if [ -n "${GUIREC_PID}" ] && kill -0 "${GUIREC_PID}" 2>/dev/null ; then
            GUIREC_TIME="$(tail -c 4096 "${VRECORD_RECORD_LOG_TMP}" 2>/dev/null | grep -o 'time=[0-9:.]*' | tail -n 1 | cut -d= -f2)"
            echo "recording ${GUIREC_TIME:-starting...}" > "${VRECORD_RECORD_STATUS_TMP}"
            return 0
        fi
    fi
    GUIREC_LAST="$(tail -n 3 "${VRECORD_RECORD_LOG_TMP}" 2>/dev/null | grep -vE '^frame=' | tail -n 1)"
    if [ -n "${GUIREC_LAST}" ] ; then
        echo "done: ${GUIREC_LAST}" > "${VRECORD_RECORD_STATUS_TMP}"
    else
        echo "idle" > "${VRECORD_RECORD_STATUS_TMP}"
    fi
}

# Video Preview tab: start the recording in a terminal window (classic vrecord
# style) while the settings window stays open with its controls
_popout_recording(){
    if [ -f "${VRECORD_RECORD_PID_TMP}" ] && kill -0 "$(cat "${VRECORD_RECORD_PID_TMP}")" 2>/dev/null ; then
        echo "already recording from this window" > "${VRECORD_RECORD_STATUS_TMP}"
        return 0
    fi
    if [ -z "${ID}" ] ; then
        echo "enter a Name of Recording first" > "${VRECORD_RECORD_STATUS_TMP}"
        return 1
    fi
    GUIREC_INPUT="${DEVICE_INPUT_CHOICE}"
    if [ "${GUIREC_INPUT}" = "4" ] ; then
        GUIREC_INPUT="${INPUT_CHOICE_MEM}"
    fi
    if [ -z "${GUIREC_INPUT}" ] || [ "${GUIREC_INPUT}" = "3" ] ; then
        echo "select an input on the Decklink, DV, or Audio tab first" > "${VRECORD_RECORD_STATUS_TMP}"
        return 1
    fi
    _stop_video_preview
    _stop_file_playback
    _update_config_file
    if command -v gnome-terminal >/dev/null 2>&1 ; then
        GUIREC_TERM="gnome-terminal --"
    elif command -v mate-terminal >/dev/null 2>&1 ; then
        GUIREC_TERM="mate-terminal --"
    elif command -v konsole >/dev/null 2>&1 ; then
        GUIREC_TERM="konsole -e"
    elif command -v xterm >/dev/null 2>&1 ; then
        GUIREC_TERM="xterm -e"
    else
        echo "no terminal emulator found - use Record instead" > "${VRECORD_RECORD_STATUS_TMP}"
        return 1
    fi
    VRECORD_BIN="${VRECORD_BIN}" VRECORD_ID="${ID}" ${GUIREC_TERM} bash -c '"${VRECORD_BIN}" "${VRECORD_ID}" ; echo "" ; echo "vrecord finished - press Enter to close" ; read VRECORD_CLOSE' &
    echo "popped out to a terminal window - this window stays open" > "${VRECORD_RECORD_STATUS_TMP}"
}

# Video Preview tab: stop a background preview/playback process
# (SIGTERM with a short grace period, then SIGKILL, so the device is always released)
_stop_bg_process(){
    if [ -f "${1}" ] ; then
        BG_PID="$(cat "${1}")"
        if [ -n "${BG_PID}" ] && kill -0 "${BG_PID}" 2>/dev/null ; then
            kill "${BG_PID}" 2>/dev/null
            BG_WAIT=0
            while [ "${BG_WAIT}" -lt 30 ] && kill -0 "${BG_PID}" 2>/dev/null ; do
                sleep 0.1
                BG_WAIT=$(( BG_WAIT + 1 ))
            done
            if kill -0 "${BG_PID}" 2>/dev/null ; then
                kill -9 "${BG_PID}" 2>/dev/null
            fi
        fi
        rm -f "${1}"
    fi
    echo "stopped" > "${2}"
}

_stop_video_preview(){
    _stop_bg_process "${VRECORD_PREVIEW_PID_TMP}" "${VRECORD_PREVIEW_STATUS_TMP}"
}

_stop_file_playback(){
    _stop_bg_process "${VRECORD_FILEPLAY_PID_TMP}" "${VRECORD_FILEPLAY_STATUS_TMP}"
    rm -f "${VRECORD_PLAY_POS_TMP}"
}

# Video Preview tab: keep a status display in sync with a background preview/playback process
_refresh_bg_status(){
    if [ -f "${1}" ] ; then
        BG_PID="$(cat "${1}")"
        if [ -n "${BG_PID}" ] && kill -0 "${BG_PID}" 2>/dev/null ; then
            echo "${4} (pid ${BG_PID})" > "${3}"
            return 0
        fi
    fi
    BG_LASTLINE="$(tail -n 1 "${2}" 2>/dev/null)"
    if [ -n "${BG_LASTLINE}" ] ; then
        echo "stopped: ${BG_LASTLINE}" > "${3}"
    else
        echo "stopped" > "${3}"
    fi
}

_refresh_video_preview_status(){
    _refresh_bg_status "${VRECORD_PREVIEW_PID_TMP}" "${VRECORD_PREVIEW_LOG_TMP}" "${VRECORD_PREVIEW_STATUS_TMP}" "running"
}

_refresh_file_playback_status(){
    FP_DUR="$(cat "${VRECORD_FILEPLAY_DUR_TMP}" 2>/dev/null)"
    FP_DURHMS=""
    if [ -n "${FP_DUR}" ] ; then
        FP_DURHMS="$(awk -v s="${FP_DUR}" 'BEGIN { printf "%02d:%02d:%02d", int(s/3600), int((s%3600)/60), int(s%60) }')"
    fi
    FP_TIME="$(tail -c 4096 "${VRECORD_FILEPLAY_LOG_TMP}" 2>/dev/null | grep -o 'time=[0-9:.]*' | tail -n 1 | cut -d= -f2)"
    if [ -f "${VRECORD_FILEPLAY_PID_TMP}" ] ; then
        BG_PID="$(cat "${VRECORD_FILEPLAY_PID_TMP}")"
        if [ -n "${BG_PID}" ] && kill -0 "${BG_PID}" 2>/dev/null ; then
            # only track the position while the playback process is alive
            if [ -n "${FP_TIME}" ] ; then
                echo "${VRECORD_PLAY_FILE}|${FP_TIME}" > "${VRECORD_PLAY_POS_TMP}"
            fi
            echo "playing ${FP_TIME:-00:00:00.00}${FP_DURHMS:+ / ${FP_DURHMS}}" > "${VRECORD_FILEPLAY_STATUS_TMP}"
            return 0
        fi
    fi
    FP_POS="$(cat "${VRECORD_PLAY_POS_TMP}" 2>/dev/null)"
    if [ -n "${FP_POS}" ] && [ "$(echo "${FP_POS}" | cut -d'|' -f1)" = "${VRECORD_PLAY_FILE}" ] ; then
        FP_LAST="$(echo "${FP_POS}" | cut -d'|' -f2)"
        FP_LASTSEC="$(echo "${FP_LAST}" | awk -F: '{ if (NF==3) print $1*3600+$2*60+$3 ; else print $1 }')"
        if [ -n "${FP_DUR}" ] && [ "$(awk -v a="${FP_LASTSEC}" -v b="${FP_DUR}" 'BEGIN { print (a+0 >= b-0.05) ? 1 : 0 }')" = "1" ] ; then
            echo "finished${FP_DURHMS:+ (${FP_DURHMS})}" > "${VRECORD_FILEPLAY_STATUS_TMP}"
            return 0
        fi
        echo "paused at ${FP_LAST} - toggle Play to resume" > "${VRECORD_FILEPLAY_STATUS_TMP}"
        return 0
    fi
    FP_ERR="$(grep -vE '^frame=' "${VRECORD_FILEPLAY_LOG_TMP}" 2>/dev/null | tail -n 1)"
    if [ -n "${FP_ERR}" ] ; then
        echo "stopped: ${FP_ERR}" > "${VRECORD_FILEPLAY_STATUS_TMP}"
    else
        echo "stopped" > "${VRECORD_FILEPLAY_STATUS_TMP}"
    fi
}

# combine the HH/MM/SS recording time boxes into DURATION (POSIX; all boxes blank means an unlimited recording)
_combine_duration_fields(){
    if [ -n "${DURATION_HOURS}" ] || [ -n "${DURATION_MINUTES}" ] || [ -n "${DURATION_SECONDS}" ] ; then
        DURATION="${DURATION_HOURS:-0}:${DURATION_MINUTES:-0}:${DURATION_SECONDS:-0}"
    else
        DURATION=""
    fi
}

_update_config_file(){
    # write config file
    _combine_duration_fields
    # the Video Preview tab is not an input choice; keep the last real input tab
    if [ "${DEVICE_INPUT_CHOICE}" = "4" ] ; then
        DEVICE_INPUT_CHOICE="${INPUT_CHOICE_MEM}"
    fi
    {
        echo "# Set these variables to a valid option or leave as empty quotes (like \"\") to request each run."
        echo "STARTUP_VIEW=\"${STARTUP_VIEW}\""
        echo "DEVICE_INPUT_CHOICE=\"${DEVICE_INPUT_CHOICE}\""
        echo "VIDEO_INPUT_CHOICE=\"${VIDEO_INPUT_CHOICE}\""
        echo "AUDIO_INPUT_CHOICE=\"${AUDIO_INPUT_CHOICE}\""
        echo "CONTAINER_CHOICE=\"${CONTAINER_CHOICE}\""
        echo "VIDEO_CODEC_CHOICE=\"${VIDEO_CODEC_CHOICE}\""
