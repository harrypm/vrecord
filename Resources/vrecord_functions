# these functions are appended to an include file that is sent to gtkdialog and allows for functions to be used within gtkdialog actions

# functions

_check_ffmpeg_install(){
    echo "Using ffmpeg at ${FFMPEG_BIN}"
    echo
    if [ ! -f "${FFMPEG_BIN}" ] ; then
        echo "${FFMPEG_BIN} is not found. Please install ffmpeg-ma via:"
        echo "    brew install mediaarea/mediaarea/ffmpeg-ma"
        echo "Or install a version of ffmpeg that is compiled with decklink support if you wish to use that input."
        echo
    fi
    if [ ! -f "${FFPLAY_BIN}" ] ; then
        echo "${FFPLAY_BIN} is not found."
        echo
    fi
    if [ ! -f "${FFPROBE_BIN}" ] ; then
        echo "${FFPROBE_BIN} is not found."
        echo
    fi
    echo
    FFMPEG_V="$("${FFMPEG_BIN}" -version 2>&1)"
    echo "FFmpeg configuration: ${FFMPEG_V}"
    echo
    if [ "$(echo "${FFMPEG_V}" | grep "Library not loaded" >/dev/null)" ] ; then
        echo "Please reinstall 'ffmpeg-ma':"
        echo "    brew reinstall mediaarea/mediaarea/ffmpeg-ma"
        echo "Or install a version of ffmpeg that is compiled with decklink support if you wish to use that input."
        echo "Exiting."
        exit 1
    fi
    if ! "${FFMPEG_BIN}" -hide_banner -devices 2>/dev/null | grep -q decklink ; then
        echo "vrecord is set to use a decklink input but ${FFMPEG_BIN} does not appear to support decklink inputs."
        echo "Please review installation and troubleshooting information for vrecord or install ffmpeg-ma."
        exit 1
    fi
}

# build (and cache) the small compiled helper that reads preview frames from a
# fifo through a one-second ring buffer and re-clocks them to the display file;
# without a C compiler the preview falls back to a capped shell reader
_ensure_preview_reader(){
    PREVIEW_READER=""
    PREVIEW_READER_CC=""
    if command -v cc >/dev/null 2>&1 ; then
        PREVIEW_READER_CC="cc"
    elif command -v gcc >/dev/null 2>&1 ; then
        PREVIEW_READER_CC="gcc"
    elif command -v clang >/dev/null 2>&1 ; then
        PREVIEW_READER_CC="clang"
    fi
    if [ -z "${PREVIEW_READER_CC}" ] || [ ! -f "${RESOURCE_PATH}/vrecord_preview_reader.c" ] ; then
        return 0
    fi
    PREVIEW_CACHE="${HOME}/.cache/vrecord"
    mkdir -p "${PREVIEW_CACHE}" 2>/dev/null
    PREVIEW_READER="${PREVIEW_CACHE}/vrecord-preview-reader"
    PREVIEW_STAMP="$(cksum "${RESOURCE_PATH}/vrecord_preview_reader.c" 2>/dev/null | cut -d' ' -f1)"
    if [ ! -x "${PREVIEW_READER}" ] || [ "${PREVIEW_STAMP}" != "$(cat "${PREVIEW_CACHE}/reader.stamp" 2>/dev/null)" ] ; then
        if "${PREVIEW_READER_CC}" -O2 -o "${PREVIEW_READER}.new" "${RESOURCE_PATH}/vrecord_preview_reader.c" 2>/dev/null ; then
            mv -f "${PREVIEW_READER}.new" "${PREVIEW_READER}"
            echo "${PREVIEW_STAMP}" > "${PREVIEW_CACHE}/reader.stamp"
        else
            PREVIEW_READER=""
        fi
    fi
}

# Video Preview tab: show black in a preview pane when no feed is active, so
# the pane never renders a missing-file warning icon
_write_black_ppm(){
    BK_W=480
    BK_H=324
    case "${STANDARD_CHOICE}" in
        "PAL")                    BK_H=384 ;;
        23ps*|24ps*|Hp*|Hi*|hp*|2d*|4k*|4d*)  BK_H=270 ;;
    esac
    rm -f "${1}"
    { printf "P6\n%s %s\n255\n" "${BK_W}" "${BK_H}"
      head -c $(( BK_W * BK_H * 3 )) /dev/zero
    } > "${1}"
}

# snap the settings window to a preset position and size (screen halves or a
# quarter, for split-screen workflows); needs wmctrl, which most X11 desktops ship
_snap_window(){
    SNAP_PRESET="${1}"
    command -v wmctrl >/dev/null 2>&1 || return 1
    # screen dimensions: the current mode via xrandr, falling back to xdpyinfo
    SNAP_W=""
    SNAP_H=""
    if command -v xrandr >/dev/null 2>&1 ; then
        SNAP_MODE="$(xrandr --current 2>/dev/null | awk '/\*/{print $1 ; exit}')"
        if [ -n "${SNAP_MODE}" ] ; then
            SNAP_W="${SNAP_MODE%x*}"
            SNAP_H="${SNAP_MODE#*x}"
        fi
    fi
    if [ -z "${SNAP_W}" ] && command -v xdpyinfo >/dev/null 2>&1 ; then
        SNAP_MODE="$(xdpyinfo 2>/dev/null | awk '/dimensions:/{print $2 ; exit}')"
        SNAP_W="${SNAP_MODE%x*}"
        SNAP_H="${SNAP_MODE#*x}"
    fi
    [ -z "${SNAP_W}" ] && return 1
    case "${SNAP_PRESET}" in
        left)    SNAP_X=0 ;           SNAP_Y=0 ; SNAP_GW=$(( SNAP_W / 2 )) ; SNAP_GH="${SNAP_H}" ;;
        right)   SNAP_X=$(( SNAP_W / 2 )) ; SNAP_Y=0 ; SNAP_GW=$(( SNAP_W / 2 )) ; SNAP_GH="${SNAP_H}" ;;
        quarter) SNAP_X=0 ;           SNAP_Y=0 ; SNAP_GW=$(( SNAP_W / 2 )) ; SNAP_GH=$(( SNAP_H / 2 )) ;;
        full)    wmctrl -r :ACTIVE: -b toggle,maximized 2>/dev/null ; return 0 ;;
        *) return 1 ;;
    esac
    wmctrl -r :ACTIVE: -b remove,maximized_vert,maximized_horz 2>/dev/null
    wmctrl -r :ACTIVE: -e "0,${SNAP_X},${SNAP_Y},${SNAP_GW},${SNAP_GH}" 2>/dev/null
}

# Video Preview tab: react to the relay checkbox - restart the input preview so
# the device output matches immediately: relay on feeds the output, relay off
# blacks it out until the relay is re-enabled or a file is played
_apply_relay_state(){
    if [ -f "${VRECORD_PREVIEW_PID_TMP}" ] && kill -0 "$(cat "${VRECORD_PREVIEW_PID_TMP}")" 2>/dev/null ; then
        _stop_video_preview
        _start_video_preview
    fi
}

# Video Preview tab: launch a background preview of the decklink input that
# writes a regularly updated preview for the settings window and, when the relay
# option is on, sends the feed to the selected device's output through the
# Blackmagic SDK (SDI, HDMI, or analogue, depending on the card's connectors)
_start_video_preview(){
    if [ -f "${VRECORD_PREVIEW_PID_TMP}" ] && kill -0 "$(cat "${VRECORD_PREVIEW_PID_TMP}")" 2>/dev/null ; then
        echo "preview already running" > "${VRECORD_PREVIEW_STATUS_TMP}"
        return 0
    fi
    if [ -f "${VRECORD_RECORD_PID_TMP}" ] && kill -0 "$(cat "${VRECORD_RECORD_PID_TMP}")" 2>/dev/null ; then
        echo "recording in progress - stop it first" > "${VRECORD_PREVIEW_STATUS_TMP}"
        return 1
    fi
    if [ -z "${DECKLINK_INPUT_CHOICE}" ] ; then
        echo "select a video card on the Decklink tab first" > "${VRECORD_PREVIEW_STATUS_TMP}"
        return 1
    fi
    case "${STANDARD_CHOICE}" in
        "NTSC")                PREVIEW_FORMAT="ntsc" ; PREVIEW_SRCW=720  ; PREVIEW_SRCH=486  ;;
        "PAL")                 PREVIEW_FORMAT="pal"  ; PREVIEW_SRCW=720  ; PREVIEW_SRCH=576  ;;
        "23ps - 1080p23.98")   PREVIEW_FORMAT="23ps" ; PREVIEW_SRCW=1920 ; PREVIEW_SRCH=1080 ;;
        "24ps - 1080p24")      PREVIEW_FORMAT="24ps" ; PREVIEW_SRCW=1920 ; PREVIEW_SRCH=1080 ;;
        "Hp25 - 1080p25")      PREVIEW_FORMAT="Hp25" ; PREVIEW_SRCW=1920 ; PREVIEW_SRCH=1080 ;;
        "Hp29 - 1080p29.97")   PREVIEW_FORMAT="Hp29" ; PREVIEW_SRCW=1920 ; PREVIEW_SRCH=1080 ;;
        "Hp30 - 1080p30")      PREVIEW_FORMAT="Hp30" ; PREVIEW_SRCW=1920 ; PREVIEW_SRCH=1080 ;;
        "Hi50 - 1080i50")      PREVIEW_FORMAT="Hi50" ; PREVIEW_SRCW=1920 ; PREVIEW_SRCH=1080 ;;
        "Hi59 - 1080i59.94")   PREVIEW_FORMAT="Hi59" ; PREVIEW_SRCW=1920 ; PREVIEW_SRCH=1080 ;;
        "Hi60 - 1080i60")      PREVIEW_FORMAT="Hi60" ; PREVIEW_SRCW=1920 ; PREVIEW_SRCH=1080 ;;
        "hp50 - 720p50")       PREVIEW_FORMAT="hp50" ; PREVIEW_SRCW=1280 ; PREVIEW_SRCH=720  ;;
        "hp59 - 720p59.94")    PREVIEW_FORMAT="hp59" ; PREVIEW_SRCW=1280 ; PREVIEW_SRCH=720  ;;
        "hp60 - 720p60")       PREVIEW_FORMAT="hp60" ; PREVIEW_SRCW=1280 ; PREVIEW_SRCH=720  ;;
        "Hp50 - 1080p50")      PREVIEW_FORMAT="Hp50" ; PREVIEW_SRCW=1920 ; PREVIEW_SRCH=1080 ;;
        "Hp59 - 1080p59.94")   PREVIEW_FORMAT="Hp59" ; PREVIEW_SRCW=1920 ; PREVIEW_SRCH=1080 ;;
        "Hp60 - 1080p60")      PREVIEW_FORMAT="Hp60" ; PREVIEW_SRCW=1920 ; PREVIEW_SRCH=1080 ;;
        "2d23 - 2048p23.98")   PREVIEW_FORMAT="2d23" ; PREVIEW_SRCW=2048 ; PREVIEW_SRCH=1080 ;;
        "2d24 - 2048p24")      PREVIEW_FORMAT="2d24" ; PREVIEW_SRCW=2048 ; PREVIEW_SRCH=1080 ;;
        "2d25 - 2048p25")      PREVIEW_FORMAT="2d25" ; PREVIEW_SRCW=2048 ; PREVIEW_SRCH=1080 ;;
        "2d29 - 2048p29.97")   PREVIEW_FORMAT="2d29" ; PREVIEW_SRCW=2048 ; PREVIEW_SRCH=1080 ;;
        "2d30 - 2048p30")      PREVIEW_FORMAT="2d30" ; PREVIEW_SRCW=2048 ; PREVIEW_SRCH=1080 ;;
        "2d50 - 2048p50")      PREVIEW_FORMAT="2d50" ; PREVIEW_SRCW=2048 ; PREVIEW_SRCH=1080 ;;
        "2d59 - 2048p59.94")   PREVIEW_FORMAT="2d59" ; PREVIEW_SRCW=2048 ; PREVIEW_SRCH=1080 ;;
        "2d60 - 2048p60")      PREVIEW_FORMAT="2d60" ; PREVIEW_SRCW=2048 ; PREVIEW_SRCH=1080 ;;
        "4k23 - UHD 23.98")    PREVIEW_FORMAT="4k23" ; PREVIEW_SRCW=3840 ; PREVIEW_SRCH=2160 ;;
        "4k24 - UHD 24")       PREVIEW_FORMAT="4k24" ; PREVIEW_SRCW=3840 ; PREVIEW_SRCH=2160 ;;
        "4k25 - UHD 25")       PREVIEW_FORMAT="4k25" ; PREVIEW_SRCW=3840 ; PREVIEW_SRCH=2160 ;;
        "4k29 - UHD 29.97")    PREVIEW_FORMAT="4k29" ; PREVIEW_SRCW=3840 ; PREVIEW_SRCH=2160 ;;
        "4k30 - UHD 30")       PREVIEW_FORMAT="4k30" ; PREVIEW_SRCW=3840 ; PREVIEW_SRCH=2160 ;;
        "4k50 - UHD 50")       PREVIEW_FORMAT="4k50" ; PREVIEW_SRCW=3840 ; PREVIEW_SRCH=2160 ;;
        "4k59 - UHD 59.94")    PREVIEW_FORMAT="4k59" ; PREVIEW_SRCW=3840 ; PREVIEW_SRCH=2160 ;;
        "4k60 - UHD 60")       PREVIEW_FORMAT="4k60" ; PREVIEW_SRCW=3840 ; PREVIEW_SRCH=2160 ;;
        "4d23 - 4K DCI 23.98") PREVIEW_FORMAT="4d23" ; PREVIEW_SRCW=4096 ; PREVIEW_SRCH=2160 ;;
        "4d24 - 4K DCI 24")    PREVIEW_FORMAT="4d24" ; PREVIEW_SRCW=4096 ; PREVIEW_SRCH=2160 ;;
        "4d25 - 4K DCI 25")    PREVIEW_FORMAT="4d25" ; PREVIEW_SRCW=4096 ; PREVIEW_SRCH=2160 ;;
        "4d29 - 4K DCI 29.97") PREVIEW_FORMAT="4d29" ; PREVIEW_SRCW=4096 ; PREVIEW_SRCH=2160 ;;
        "4d30 - 4K DCI 30")    PREVIEW_FORMAT="4d30" ; PREVIEW_SRCW=4096 ; PREVIEW_SRCH=2160 ;;
        "4d50 - 4K DCI 50")    PREVIEW_FORMAT="4d50" ; PREVIEW_SRCW=4096 ; PREVIEW_SRCH=2160 ;;
        "4d59 - 4K DCI 59.94") PREVIEW_FORMAT="4d59" ; PREVIEW_SRCW=4096 ; PREVIEW_SRCH=2160 ;;
        "4d60 - 4K DCI 60")    PREVIEW_FORMAT="4d60" ; PREVIEW_SRCW=4096 ; PREVIEW_SRCH=2160 ;;
        "")     echo "select a standard on the Decklink tab first" > "${VRECORD_PREVIEW_STATUS_TMP}" ; return 1 ;;
        *)      echo "unsupported standard: ${STANDARD_CHOICE}" > "${VRECORD_PREVIEW_STATUS_TMP}" ; return 1 ;;
    esac
    case "${VIDEO_INPUT_CHOICE}" in
        "Composite") PREVIEW_VINPUT="composite" ;;
        "HDMI")      PREVIEW_VINPUT="hdmi" ;;
        "Component") PREVIEW_VINPUT="component" ;;
        "S-Video")   PREVIEW_VINPUT="s_video" ;;
        *)           PREVIEW_VINPUT="sdi" ;;
    esac
    # build the compiled frame reader (falls back to a shell reader without a C compiler)
    _ensure_preview_reader
    # build the ffmpeg arguments as positional parameters so device names with spaces stay intact
    set -- "${FFMPEG_BIN}" -nostdin -nostats -loglevel error -y -format_code "${PREVIEW_FORMAT}" -video_input "${PREVIEW_VINPUT}"
    if [ "${PREVIEW_RELAY_CHOICE}" = "true" ] ; then
        case "${AUDIO_INPUT_CHOICE}" in
            "SDI Embedded Audio")      PREVIEW_AINPUT="embedded" ;;
            "Digital Audio (AES/EBU)") PREVIEW_AINPUT="aes_ebu" ;;
            *)                         PREVIEW_AINPUT="analog" ;;
        esac
        set -- "$@" -audio_input "${PREVIEW_AINPUT}"
    fi
    set -- "$@" -f decklink -i "${DECKLINK_INPUT_CHOICE}"
    if [ -n "${PREVIEW_READER}" ] ; then
        # native frame rate: the compiled reader re-clocks the output on a wall-clock schedule
        set -- "$@" -map 0:v -vf scale=480:-2 -f rawvideo -pix_fmt rgb24 "${VRECORD_PREVIEW_FIFO}"
    else
        set -- "$@" -map 0:v -vf "scale=480:-2,fps=15" -f rawvideo -pix_fmt rgb24 "${VRECORD_PREVIEW_FIFO}"
    fi
    if [ "${PREVIEW_RELAY_CHOICE}" = "true" ] ; then
        PREVIEW_RELAY_DEV="${DECKLINK_INPUT_CHOICE}"
        if [ -n "${PREVIEW_RELAY_DEV_CHOICE}" ] ; then
            PREVIEW_RELAY_DEV="${PREVIEW_RELAY_DEV_CHOICE}"
        fi
        set -- "$@" -map 0:v -map 0:a -c:v v210 -c:a pcm_s16le -ar 48000 -ac 2 -f decklink "${PREVIEW_RELAY_DEV}"
    fi
    # the preview and the file playout share the output device: playout yields
    _stop_file_playback
    _stop_test_signal
    _write_black_ppm "${VRECORD_PREVIEW_TMP}"
    rm -f "${VRECORD_PREVIEW_FIFO}"
    mkfifo "${VRECORD_PREVIEW_FIFO}"
    # lossless preview: raw RGB frames through a fifo; a reader wraps each frame in a
    # PPM header and renames it into place atomically so the pane never shows a torn frame
    PREVIEW_W=480
    PREVIEW_H="$(awk -v w="${PREVIEW_SRCW}" -v h="${PREVIEW_SRCH}" 'BEGIN { printf "%d", int(((480 * h / w) + 1) / 2) * 2 }')"
    if [ -n "${PREVIEW_READER}" ] ; then
        # one second software playout delay: the reader buffers the frames and re-clocks them
        "${PREVIEW_READER}" "${VRECORD_PREVIEW_FIFO}" "${VRECORD_PREVIEW_TMP}" "${PREVIEW_W}" "${PREVIEW_H}" 1 > /dev/null 2>&1 &
    else
        PREVIEW_PIX=$(( PREVIEW_W * PREVIEW_H * 3 ))
        PREPIX="${PREVIEW_PIX}" PREW="${PREVIEW_W}" PREH="${PREVIEW_H}" PREDISP="${VRECORD_PREVIEW_TMP}" \
            sh -c 'while head -c "${PREPIX}" > "${PREDISP}.frame" 2>/dev/null ; do
                      [ "$(wc -c < "${PREDISP}.frame")" = "${PREPIX}" ] || break
                      { printf "P6\n%s %s\n255\n" "${PREW}" "${PREH}" ; cat "${PREDISP}.frame" ; } > "${PREDISP}.new"
                      mv -f "${PREDISP}.new" "${PREDISP}"
                  done' < "${VRECORD_PREVIEW_FIFO}" > /dev/null 2>&1 &
    fi
    echo $! > "${VRECORD_PREVIEW_RPID_TMP}"
    echo "starting preview..." > "${VRECORD_PREVIEW_STATUS_TMP}"
    "$@" > "${VRECORD_PREVIEW_LOG_TMP}" 2>&1 &
    echo $! > "${VRECORD_PREVIEW_PID_TMP}"
    if [ "${PREVIEW_RELAY_CHOICE}" = "true" ] ; then
        # the output pane shows the relayed feed while it runs
        ln -sf "${VRECORD_PREVIEW_TMP}" "${VRECORD_OUTPUT_DISPLAY_TMP}"
    fi
}

# convert a playout stats time to the absolute file position: input seeks
# (-ss) rebase ffmpeg's time= counter to zero, so the seek offset is added back
_fp_abs_time(){
    FP_OFF="$(cat "${VRECORD_PLAY_OFFSET_TMP}" 2>/dev/null)"
    awk -v t="${1}" -v o="${FP_OFF:-00:00:00.00}" 'BEGIN {
        n = split(t, a, ":") ; ts = (n == 3) ? a[1]*3600 + a[2]*60 + a[3] : t + 0
        m = split(o, b, ":") ; os = (m == 3) ? b[1]*3600 + b[2]*60 + b[3] : o + 0
        v = ts + os
        printf "%02d:%02d:%06.3f", int(v/3600), int((v%3600)/60), v%60
    }'
}

# Video Preview tab: play a media file out to the selected device's output
# through the Blackmagic SDK, converting on the fly to the output mode of the
# selected standard (video size, frame rate, and field order)
_start_file_playback(){
    if [ -f "${VRECORD_FILEPLAY_PID_TMP}" ] && kill -0 "$(cat "${VRECORD_FILEPLAY_PID_TMP}")" 2>/dev/null ; then
        echo "file playback already running" > "${VRECORD_FILEPLAY_STATUS_TMP}"
        return 0
    fi
    if [ -f "${VRECORD_RECORD_PID_TMP}" ] && kill -0 "$(cat "${VRECORD_RECORD_PID_TMP}")" 2>/dev/null ; then
        echo "recording in progress - stop it first" > "${VRECORD_FILEPLAY_STATUS_TMP}"
        return 1
    fi
    if [ -z "${VRECORD_PLAY_FILE}" ] ; then
        echo "select a file to play first" > "${VRECORD_FILEPLAY_STATUS_TMP}"
        return 1
    fi
    if [ ! -f "${VRECORD_PLAY_FILE}" ] ; then
        echo "file not found: ${VRECORD_PLAY_FILE}" > "${VRECORD_FILEPLAY_STATUS_TMP}"
        return 1
    fi
    FILEPLAY_DEV="${PREVIEW_RELAY_DEV_CHOICE:-${DECKLINK_INPUT_CHOICE}}"
    if [ -z "${FILEPLAY_DEV}" ] ; then
        echo "select an output device first" > "${VRECORD_FILEPLAY_STATUS_TMP}"
        return 1
    fi
    # remember the selected file across sessions
    _update_config_file
    FP_PROBE="${FFPROBE_BIN}"
    if [ -z "${FP_PROBE}" ] || [ ! -x "${FP_PROBE}" ] ; then
        FP_PROBE="$(dirname "${FFMPEG_BIN}")/ffprobe-ma"
    fi
    if [ -z "${FP_PROBE}" ] || [ ! -x "${FP_PROBE}" ] ; then
        FP_PROBE="$(command -v ffprobe 2>/dev/null)"
    fi
    # auto-detect mode: play the file at its native size, rate, and interlacing
    # instead of converting to the selected standard; broadcast size/rate combos
    # get an explicit decklink format code so the card does not have to guess the
    # mode (SD modes are interlaced-only, so files with an unmarked field order
    # get the standard's default field marking)
    FP_AUTO="false"
    FP_VF=""
    FP_RATE_STR=""
    FP_FORMAT_CODE=""
    if [ "${FILEPLAY_AUTO_CHOICE:-true}" != "false" ] ; then
        FP_RATE_STR="$(${FP_PROBE} -v error -select_streams v:0 -show_entries stream=r_frame_rate -of csv=p=0 "${VRECORD_PLAY_FILE}" 2>/dev/null)"
        FP_FIELD_STR="$(${FP_PROBE} -v error -select_streams v:0 -show_entries stream=field_order -of csv=p=0 "${VRECORD_PLAY_FILE}" 2>/dev/null)"
        FP_DIMS_STR="$(${FP_PROBE} -v error -select_streams v:0 -show_entries stream=width,height -of csv=p=0 "${VRECORD_PLAY_FILE}" 2>/dev/null)"
        if echo "${FP_RATE_STR}" | grep -qE '^[0-9]+/[0-9]+$' ; then
            FP_AUTO="true"
            FP_AW="${FP_DIMS_STR%%,*}"
            FP_AH="${FP_DIMS_STR##*,}"
            FP_INTER="progressive"
            # ffprobe reports tt/tb (top coded first) and bb/bt (bottom coded
            # first) as well as tff/bff spellings: all are interlaced
            case "${FP_FIELD_STR}" in
                tt|TT|tff|TFF|tb|TB) FP_VF="setfield=tff" ; FP_INTER="interlaced" ;;
                bb|BB|bff|BFF|bt|BT) FP_VF="setfield=bff" ; FP_INTER="interlaced" ;;
            esac
            # deterministic mode selection for broadcast formats
            case "${FP_AW}x${FP_AH}@${FP_RATE_STR}" in
                720x486@30000/1001)  FP_FORMAT_CODE="ntsc" ; if [ -z "${FP_VF}" ] ; then FP_VF="setfield=bff" ; fi ;;
                720x480@30000/1001)  FP_FORMAT_CODE="ntsc" ; if [ -n "${FP_VF}" ] ; then FP_VF="scale=720:486,${FP_VF}" ; else FP_VF="scale=720:486,setfield=bff" ; fi ;;
                720x576@25/1)        FP_FORMAT_CODE="pal"  ; if [ -z "${FP_VF}" ] ; then FP_VF="setfield=tff" ; fi ;;
                1920x1080@24000/1001) FP_FORMAT_CODE="23ps" ;;
                1920x1080@24/1)      FP_FORMAT_CODE="24ps" ;;
                1920x1080@25/1)      if [ "${FP_INTER}" = "interlaced" ] ; then FP_FORMAT_CODE="Hi50" ; else FP_FORMAT_CODE="Hp25" ; fi ;;
                1920x1080@30000/1001) if [ "${FP_INTER}" = "interlaced" ] ; then FP_FORMAT_CODE="Hi59" ; else FP_FORMAT_CODE="Hp29" ; fi ;;
                1920x1080@30/1)      if [ "${FP_INTER}" = "interlaced" ] ; then FP_FORMAT_CODE="Hi60" ; else FP_FORMAT_CODE="Hp30" ; fi ;;
                1280x720@50/1)       FP_FORMAT_CODE="hp50" ;;
                1280x720@60000/1001) FP_FORMAT_CODE="hp59" ;;
                1280x720@60/1)       FP_FORMAT_CODE="hp60" ;;
                1920x1080@50/1)      FP_FORMAT_CODE="Hp50" ;;
                1920x1080@60000/1001) FP_FORMAT_CODE="Hp59" ;;
                1920x1080@60/1)      FP_FORMAT_CODE="Hp60" ;;
                2048x1080@24000/1001) FP_FORMAT_CODE="2d23" ;;
                2048x1080@24/1)      FP_FORMAT_CODE="2d24" ;;
                2048x1080@25/1)      FP_FORMAT_CODE="2d25" ;;
                2048x1080@30000/1001) FP_FORMAT_CODE="2d29" ;;
                2048x1080@30/1)      FP_FORMAT_CODE="2d30" ;;
                2048x1080@50/1)      FP_FORMAT_CODE="2d50" ;;
                2048x1080@60000/1001) FP_FORMAT_CODE="2d59" ;;
                2048x1080@60/1)      FP_FORMAT_CODE="2d60" ;;
                3840x2160@24000/1001) FP_FORMAT_CODE="4k23" ;;
                3840x2160@24/1)      FP_FORMAT_CODE="4k24" ;;
                3840x2160@25/1)      FP_FORMAT_CODE="4k25" ;;
                3840x2160@30000/1001) FP_FORMAT_CODE="4k29" ;;
                3840x2160@30/1)      FP_FORMAT_CODE="4k30" ;;
                3840x2160@50/1)      FP_FORMAT_CODE="4k50" ;;
                3840x2160@60000/1001) FP_FORMAT_CODE="4k59" ;;
                3840x2160@60/1)      FP_FORMAT_CODE="4k60" ;;
                4096x2160@24000/1001) FP_FORMAT_CODE="4d23" ;;
                4096x2160@24/1)      FP_FORMAT_CODE="4d24" ;;
                4096x2160@25/1)      FP_FORMAT_CODE="4d25" ;;
                4096x2160@30000/1001) FP_FORMAT_CODE="4d29" ;;
                4096x2160@30/1)      FP_FORMAT_CODE="4d30" ;;
                4096x2160@50/1)      FP_FORMAT_CODE="4d50" ;;
                4096x2160@60000/1001) FP_FORMAT_CODE="4d59" ;;
                4096x2160@60/1)      FP_FORMAT_CODE="4d60" ;;
                *)                   FP_FORMAT_CODE="" ;;
            esac
        fi
    fi
    if [ "${FP_AUTO}" != "true" ] ; then
    # the file is converted to the output mode of the selected standard (matching the capture settings)
    case "${STANDARD_CHOICE}" in
        "NTSC") FP_SIZE="720:486" ; FP_RATE="30000/1001" ; FP_FIELD="bff" ; FP_FORMAT_CODE="ntsc" ;;
        "PAL")  FP_SIZE="720:576" ; FP_RATE="25/1" ; FP_FIELD="tff" ; FP_FORMAT_CODE="pal" ;;
        "23ps - 1080p23.98") FP_SIZE="1920:1080" ; FP_RATE="24000/1001" ; FP_FIELD="" ; FP_FORMAT_CODE="23ps" ;;
        "24ps - 1080p24")    FP_SIZE="1920:1080" ; FP_RATE="24/1" ; FP_FIELD="" ; FP_FORMAT_CODE="24ps" ;;
        "Hp25 - 1080p25")    FP_SIZE="1920:1080" ; FP_RATE="25/1" ; FP_FIELD="" ; FP_FORMAT_CODE="Hp25" ;;
        "Hp29 - 1080p29.97") FP_SIZE="1920:1080" ; FP_RATE="30000/1001" ; FP_FIELD="" ; FP_FORMAT_CODE="Hp29" ;;
