    # castellation row on the next 1/12, and -I / 75% white / +Q / black
    # with the 3.5-7.5-11.5 IRE PLUGE trio on the bottom 1/4
    TS_SMPTE75="drawbox=x=0:w=iw*1/7:h=ih*2/3:color=0xBFBFBF:thickness=fill,drawbox=x=iw*1/7:w=iw*1/7:h=ih*2/3:color=0xBFBF00:thickness=fill,drawbox=x=iw*2/7:w=iw*1/7:h=ih*2/3:color=0x00BFBF:thickness=fill,drawbox=x=iw*3/7:w=iw*1/7:h=ih*2/3:color=0x00BF00:thickness=fill,drawbox=x=iw*4/7:w=iw*1/7:h=ih*2/3:color=0xBF00BF:thickness=fill,drawbox=x=iw*5/7:w=iw*1/7:h=ih*2/3:color=0xBF0000:thickness=fill,drawbox=x=iw*6/7:w=iw*1/7:h=ih*2/3:color=0x0000BF:thickness=fill,drawbox=x=0:w=iw*1/7:y=ih*2/3:h=ih*1/12:color=0x0000BF:thickness=fill,drawbox=x=iw*2/7:w=iw*1/7:y=ih*2/3:h=ih*1/12:color=0xBF00BF:thickness=fill,drawbox=x=iw*4/7:w=iw*1/7:y=ih*2/3:h=ih*1/12:color=0x00BFBF:thickness=fill,drawbox=x=iw*6/7:w=iw*1/7:y=ih*2/3:h=ih*1/12:color=0xBFBFBF:thickness=fill,drawbox=x=0:w=iw*1/7:y=ih*3/4:h=ih*1/4:color=0x00214D:thickness=fill,drawbox=x=iw*1/7:w=iw*1/7:y=ih*3/4:h=ih*1/4:color=0xFFFFFF:thickness=fill,drawbox=x=iw*2/7:w=iw*1/7:y=ih*3/4:h=ih*1/4:color=0x32006A:thickness=fill,drawbox=x=iw*12/21:w=iw*1/21:y=ih*3/4:h=ih*1/4:color=0x090909:thickness=fill,drawbox=x=iw*13/21:w=iw*1/21:y=ih*3/4:h=ih*1/4:color=0x131313:thickness=fill,drawbox=x=iw*14/21:w=iw*1/21:y=ih*3/4:h=ih*1/4:color=0x1D1D1D:thickness=fill"
    TS_SMPTE100="drawbox=x=0:w=iw*1/7:h=ih*2/3:color=0xFFFFFF:thickness=fill,drawbox=x=iw*1/7:w=iw*1/7:h=ih*2/3:color=0xFFFF00:thickness=fill,drawbox=x=iw*2/7:w=iw*1/7:h=ih*2/3:color=0x00FFFF:thickness=fill,drawbox=x=iw*3/7:w=iw*1/7:h=ih*2/3:color=0x00FF00:thickness=fill,drawbox=x=iw*4/7:w=iw*1/7:h=ih*2/3:color=0xFF00FF:thickness=fill,drawbox=x=iw*5/7:w=iw*1/7:h=ih*2/3:color=0xFF0000:thickness=fill,drawbox=x=iw*6/7:w=iw*1/7:h=ih*2/3:color=0x0000FF:thickness=fill,drawbox=x=0:w=iw*1/7:y=ih*2/3:h=ih*1/12:color=0x0000FF:thickness=fill,drawbox=x=iw*2/7:w=iw*1/7:y=ih*2/3:h=ih*1/12:color=0xFF00FF:thickness=fill,drawbox=x=iw*4/7:w=iw*1/7:y=ih*2/3:h=ih*1/12:color=0x00FFFF:thickness=fill,drawbox=x=iw*6/7:w=iw*1/7:y=ih*2/3:h=ih*1/12:color=0xFFFFFF:thickness=fill,drawbox=x=0:w=iw*1/7:y=ih*3/4:h=ih*1/4:color=0x00214D:thickness=fill,drawbox=x=iw*1/7:w=iw*1/7:y=ih*3/4:h=ih*1/4:color=0xFFFFFF:thickness=fill,drawbox=x=iw*2/7:w=iw*1/7:y=ih*3/4:h=ih*1/4:color=0x32006A:thickness=fill,drawbox=x=iw*12/21:w=iw*1/21:y=ih*3/4:h=ih*1/4:color=0x090909:thickness=fill,drawbox=x=iw*13/21:w=iw*1/21:y=ih*3/4:h=ih*1/4:color=0x131313:thickness=fill,drawbox=x=iw*14/21:w=iw*1/21:y=ih*3/4:h=ih*1/4:color=0x1D1D1D:thickness=fill"
    # SMPTE RP 219-1:2014 HD/UHD bars, laid out as the practice specifies:
    # pattern 1 (top 7/12) the 75% bars with 40% gray side columns at 16:9 or
    # wider; pattern 2 (next 1/12) the chroma reference row with 100% cyan
    # and 100% blue side columns and the -I patch (sub-pattern *2) under the
    # first bar; pattern 3 (next 1/12) the luminance ramp row with 100%
    # yellow and 100% red side columns, the +Q patch (sub-pattern *3), a
    # 24-step black-to-white ramp across five bar widths, and 100% white;
    # pattern 4 (bottom 1/4) the 15% gray side columns, 0% black, the 100%
    # white chip, and the -2/0/+2/0/+4% PLUGE steps. The 4:3 center is
    # always laid out in 720 units so one geometry serves both aspect
    # ratios; side panels are only drawn at 16:9 or wider. The -2% step and
    # the optional sub-black/super-white ramps sit outside the RGB range
    # and render at their clipped levels through an RGB pipeline (the -I,
    # +I, and +Q values round-trip exactly to the spec Y'Cb'Cr).
    TS_HD_WIDE="false"
    if [ $(( $(echo "${TS_SIZE%%:*}") * 9 )) -ge $(( $(echo "${TS_SIZE##*:}") * 16 )) ] ; then
        TS_HD_WIDE="true"
    fi
    TS_SMPTEHD=""
    _hd_add(){
        if [ -n "${TS_SMPTEHD}" ] ; then TS_SMPTEHD="${TS_SMPTEHD}," ; fi
        TS_SMPTEHD="${TS_SMPTEHD}${1}"
    }
    _hd_side(){
        # _hd_side X960 W960 COLOR Y H: side panel, 16:9 and wider only
        if [ "${TS_HD_WIDE}" = "true" ] ; then
            _hd_add "drawbox=x=iw*${1}/960:w=iw*${2}/960:y=${4}:h=${5}:color=${3}:thickness=fill"
        fi
    }
    _hd_c(){
        # _hd_c W720 COLOR Y H: box in the 4:3 center, advances the cursor
        if [ "${TS_HD_WIDE}" = "true" ] ; then
            _hd_add "drawbox=x=iw*$((120 + TS_HD_CX))/960:w=iw*${1}/960:y=${3}:h=${4}:color=${2}:thickness=fill"
        else
            _hd_add "drawbox=x=iw*${TS_HD_CX}/720:w=iw*${1}/720:y=${3}:h=${4}:color=${2}:thickness=fill"
        fi
        TS_HD_CX=$((TS_HD_CX + $1))
    }
    # pattern 1: 75% bars (bar widths 103 x6 then 102 across the center)
    _hd_side 0 120 0x666666 0 "ih*7/12"
    _hd_side 840 120 0x666666 0 "ih*7/12"
    TS_HD_CX=0
    for HD_C in 0xBFBFBF 0xBFBF00 0x00BFBF 0x00BF00 0xBF00BF 0xBF0000 ; do
        _hd_c 103 "${HD_C}" 0 "ih*7/12"
    done
    _hd_c 102 0x0000BF 0 "ih*7/12"
    # pattern 2: chroma reference row (-I under the first bar, 75% white on)
    _hd_side 0 120 0x00FFFF "ih*7/12" "ih*1/12"
    _hd_side 840 120 0x0000FF "ih*7/12" "ih*1/12"
    TS_HD_CX=0
    _hd_c 103 0x0000FF "ih*7/12" "ih*1/12"
    TS_HD_CX=103
    for HD_K in 1 2 3 4 5 ; do _hd_c 103 0xBFBFBF "ih*7/12" "ih*1/12" ; done
    _hd_c 102 0xBFBFBF "ih*7/12" "ih*1/12"
    # pattern 3: ramp row (+Q, 24-step ramp over five bar widths, white)
    _hd_side 0 120 0xFFFF00 "ih*8/12" "ih*1/12"
    _hd_side 840 120 0xFF0000 "ih*8/12" "ih*1/12"
    TS_HD_CX=0
    _hd_c 103 0x410078 "ih*8/12" "ih*1/12"
    TS_HD_CX=103
    HD_K=0
    while [ "${HD_K}" -lt 24 ] ; do
        HD_X0=$((103 + 514 * HD_K / 24))
        HD_X1=$((103 + 514 * (HD_K + 1) / 24))
        HD_W=$((HD_X1 - HD_X0))
        [ "${HD_W}" -le 0 ] && HD_W=1
        HD_G=$(((255 * HD_K + 12) / 23))
        HD_HEX=$(printf '0x%02X%02X%02X' "${HD_G}" "${HD_G}" "${HD_G}")
        TS_HD_CX=${HD_X0}
        _hd_c "${HD_W}" "${HD_HEX}" "ih*8/12" "ih*1/12"
        HD_K=$((HD_K + 1))
    done
    TS_HD_CX=617
    _hd_c 103 0xFFFFFF "ih*8/12" "ih*1/12"
    # pattern 4: bottom band (0% black, 100% white chip, PLUGE steps)
    _hd_side 0 120 0x262626 "ih*9/12" "ih*3/12"
    _hd_side 840 120 0x262626 "ih*9/12" "ih*3/12"
    TS_HD_CX=0
    _hd_c 154 0x000000 "ih*9/12" "ih*3/12"
    _hd_c 206 0xFFFFFF "ih*9/12" "ih*3/12"
    _hd_c 85 0x000000 "ih*9/12" "ih*3/12"
    _hd_c 34 0x000000 "ih*9/12" "ih*3/12"
    _hd_c 35 0x000000 "ih*9/12" "ih*3/12"
    _hd_c 34 0x050505 "ih*9/12" "ih*3/12"
    _hd_c 35 0x000000 "ih*9/12" "ih*3/12"
    _hd_c 34 0x0A0A0A "ih*9/12" "ih*3/12"
    _hd_c 103 0x000000 "ih*9/12" "ih*3/12"
    TS_VF="scale=${TS_SIZE}"
    case "${TEST_SIGNAL_PATTERN_CHOICE:-SMPTE Bars (75%)}" in
        "SMPTE Bars (75%)")
            TS_VSRC="color=c=black:size=${TS_SIZE_SRC}:rate=${TS_RATE}"
            TS_VF="${TS_SMPTE75}" ;;
        "SMPTE Bars (100%)")
            TS_VSRC="color=c=black:size=${TS_SIZE_SRC}:rate=${TS_RATE}"
            TS_VF="${TS_SMPTE100}" ;;
        "EBU Bars (75%)")
            TS_VSRC="color=c=black:size=${TS_SIZE_SRC}:rate=${TS_RATE}"
            TS_VF="${TS_EBU75}" ;;
        "EBU Bars (100%)")
            TS_VSRC="color=c=black:size=${TS_SIZE_SRC}:rate=${TS_RATE}"
            TS_VF="${TS_EBU100}" ;;
        "SMPTE HD Bars (75%)"|"SMPTE UHD Bars (75%)")
            TS_VSRC="color=c=black:size=${TS_SIZE_SRC}:rate=${TS_RATE}"
            TS_VF="${TS_SMPTEHD}" ;;
        "FFmpeg Bars")  TS_VSRC="testsrc=rate=${TS_RATE}" ;;
        "Test Pattern") TS_VSRC="testsrc2=rate=${TS_RATE}" ;;
        "RGB Bars")     TS_VSRC="rgbtestsrc=rate=${TS_RATE}" ;;
        "YUV Bars")     TS_VSRC="yuvtestsrc=rate=${TS_RATE}" ;;
        *)              TS_VSRC="testsrc=rate=${TS_RATE}" ;;
    esac
    if [ -n "${TS_FIELD}" ] ; then
        TS_VF="${TS_VF},setfield=${TS_FIELD}"
    fi
    # the output device is shared: file playout and the relay preview yield
    _stop_file_playback
    _stop_video_preview
    # native stereo tone (no mono upmix on the way to the card)
    case "${TEST_SIGNAL_AUDIO_CHOICE:-1 kHz Tone}" in
        "Stereo 1k/440") TS_ASRC="aevalsrc=sin(1000*2*PI*t)|cos(440*2*PI*t):channel_layout=stereo:sample_rate=48000" ;;
        "Silence")       TS_ASRC="anullsrc=r=48000:cl=stereo" ;;
        *)               TS_ASRC="aevalsrc=sin(1000*2*PI*t)|sin(1000*2*PI*t):channel_layout=stereo:sample_rate=48000" ;;
    esac
    echo "test signal (${TEST_SIGNAL_PATTERN_CHOICE:-SMPTE Bars (75%)} + ${TEST_SIGNAL_AUDIO_CHOICE:-1 kHz Tone}) playing to ${TEST_DEV}" > "${VRECORD_FILEPLAY_STATUS_TMP}"
    "${FFMPEG_BIN}" -nostdin -nostats -loglevel error -re \
        -f lavfi -i "${TS_VSRC}" \
        -f lavfi -i "${TS_ASRC}" \
        -map 0:v -map 1:a \
        -vf "${TS_VF}" \
        -c:v v210 -c:a pcm_s16le -ar 48000 -ac 2 \
        -metadata comment="vrecord-test-signal" \
        -f decklink "${TEST_DEV}" > "${VRECORD_TEST_LOG_TMP}" 2>&1 &
    echo $! > "${VRECORD_TEST_PID_TMP}"
}

# Video Preview tab: stop the test signal output (kill -9: like file playout,
# ffmpeg ignores SIGTERM for seconds while blocked on the decklink output)
_stop_test_signal(){
    if [ -f "${VRECORD_TEST_PID_TMP}" ] ; then
        TEST_PID="$(cat "${VRECORD_TEST_PID_TMP}" 2>/dev/null)"
        if [ -n "${TEST_PID}" ] && kill -0 "${TEST_PID}" 2>/dev/null ; then
            kill -9 "${TEST_PID}" 2>/dev/null
        fi
        rm -f "${VRECORD_TEST_PID_TMP}"
    fi
    # belt and braces: catch an orphaned test signal from this or a dead session
    pkill -9 -f "vrecord-test-signal" 2>/dev/null
}

# Video Preview tab: react to the test signal checkbox - start or stop the
# bars-and-tone output so the device output matches the toggle immediately
_apply_test_signal_state(){
    if [ "${TEST_SIGNAL_OUTPUT_CHOICE}" = "true" ] ; then
        _start_test_signal
    else
        if [ -f "${VRECORD_TEST_PID_TMP}" ] && kill -0 "$(cat "${VRECORD_TEST_PID_TMP}")" 2>/dev/null ; then
            _stop_test_signal
            echo "test signal stopped" > "${VRECORD_FILEPLAY_STATUS_TMP}"
        fi
    fi
}

# Video Preview tab: react to a test pattern or audio selection change -
# restart the running test signal so the new choice takes effect immediately
_change_test_signal_source(){
    if [ -f "${VRECORD_TEST_PID_TMP}" ] && kill -0 "$(cat "${VRECORD_TEST_PID_TMP}")" 2>/dev/null ; then
        _stop_test_signal
        if [ "${TEST_SIGNAL_OUTPUT_CHOICE}" = "true" ] ; then
            _start_test_signal
        fi
    fi
}

# Video Preview tab: start a recording in a separate vrecord process so the
# settings window stays open with its controls while capturing
_start_gui_recording(){
    if [ -f "${VRECORD_RECORD_PID_TMP}" ] && kill -0 "$(cat "${VRECORD_RECORD_PID_TMP}")" 2>/dev/null ; then
        echo "already recording" > "${VRECORD_RECORD_STATUS_TMP}"
        return 0
    fi
    if [ -z "${ID}" ] ; then
        echo "enter a Name of Recording first" > "${VRECORD_RECORD_STATUS_TMP}"
        return 1
    fi
    GUIREC_INPUT="${DEVICE_INPUT_CHOICE}"
    if [ "${GUIREC_INPUT}" = "4" ] ; then
        GUIREC_INPUT="${INPUT_CHOICE_MEM}"
    fi
    if [ -z "${GUIREC_INPUT}" ] || [ "${GUIREC_INPUT}" = "3" ] ; then
        echo "select an input on the Decklink, DV, or Audio tab first" > "${VRECORD_RECORD_STATUS_TMP}"
        return 1
    fi
    _stop_video_preview
    _stop_file_playback
    _stop_test_signal
    _update_config_file
    rm -f "${VRECORD_RECORD_LOG_TMP}"
    echo "starting recording..." > "${VRECORD_RECORD_STATUS_TMP}"
    "${VRECORD_BIN}" "${ID}" < /dev/null > "${VRECORD_RECORD_LOG_TMP}" 2>&1 &
    echo $! > "${VRECORD_RECORD_PID_TMP}"
}

# Video Preview tab: stop a recording started from the settings window by
# ending its playback window, so the recording process runs its post-processing
_stop_gui_recording(){
    if [ ! -f "${VRECORD_RECORD_PID_TMP}" ] ; then
        echo "not recording" > "${VRECORD_RECORD_STATUS_TMP}"
        return 0
    fi
    GUIREC_PID="$(cat "${VRECORD_RECORD_PID_TMP}")"
    if [ -n "${GUIREC_PID}" ] && kill -0 "${GUIREC_PID}" 2>/dev/null ; then
        echo "stopping recording..." > "${VRECORD_RECORD_STATUS_TMP}"
        # end the playback window first, like closing it in the classic flow
        GUIREC_PLAYER="$(pgrep -P "${GUIREC_PID}" ffplay-ma 2>/dev/null | head -n 1)"
        [ -z "${GUIREC_PLAYER}" ] && GUIREC_PLAYER="$(pgrep -P "${GUIREC_PID}" ffplay 2>/dev/null | head -n 1)"
        [ -z "${GUIREC_PLAYER}" ] && GUIREC_PLAYER="$(pgrep -P "${GUIREC_PID}" mpv 2>/dev/null | head -n 1)"
        if [ -n "${GUIREC_PLAYER}" ] ; then
            kill "${GUIREC_PLAYER}" 2>/dev/null
        fi
        # if the recorder is still running shortly after, end it too so the post-processing begins
        GUIREC_WAIT=0
        while [ "${GUIREC_WAIT}" -lt 30 ] && kill -0 "${GUIREC_PID}" 2>/dev/null ; do
            sleep 0.1
            GUIREC_WAIT=$(( GUIREC_WAIT + 1 ))
        done
        if kill -0 "${GUIREC_PID}" 2>/dev/null ; then
            GUIREC_FFMPEG="$(pgrep -P "${GUIREC_PID}" ffmpeg-ma 2>/dev/null | head -n 1)"
            [ -n "${GUIREC_FFMPEG}" ] && kill "${GUIREC_FFMPEG}" 2>/dev/null
        fi
    fi
    rm -f "${VRECORD_RECORD_PID_TMP}"
}

# Video Preview tab: keep the recording state in sync; when a recording ends,
# reset so the next recording (with a new name) can start immediately
_refresh_gui_recording_status(){
    if [ -f "${VRECORD_RECORD_PID_TMP}" ] ; then
        GUIREC_PID="$(cat "${VRECORD_RECORD_PID_TMP}")"
        if [ -n "${GUIREC_PID}" ] && kill -0 "${GUIREC_PID}" 2>/dev/null ; then
            GUIREC_TIME="$(tail -c 4096 "${VRECORD_RECORD_LOG_TMP}" 2>/dev/null | grep -o 'time=[0-9:.]*' | tail -n 1 | cut -d= -f2)"
            echo "recording ${GUIREC_TIME:-starting...}" > "${VRECORD_RECORD_STATUS_TMP}"
            return 0
        fi
        # the recording finished: clear the state so a new one can start
        rm -f "${VRECORD_RECORD_PID_TMP}"
        GUIREC_LAST="$(tail -n 3 "${VRECORD_RECORD_LOG_TMP}" 2>/dev/null | grep -vE '^frame=' | tail -n 1)"
        echo "done: ${GUIREC_LAST:-recording finished} - ready for the next recording" > "${VRECORD_RECORD_STATUS_TMP}"
        # restore the landing state (input preview with relay) unless a file playout owns the output
        if ! { [ -f "${VRECORD_FILEPLAY_PID_TMP}" ] && kill -0 "$(cat "${VRECORD_FILEPLAY_PID_TMP}")" 2>/dev/null ; } ; then
            _start_video_preview
        fi
        return 0
    fi
    GUIREC_LAST="$(tail -n 3 "${VRECORD_RECORD_LOG_TMP}" 2>/dev/null | grep -vE '^frame=' | tail -n 1)"
    if [ -n "${GUIREC_LAST}" ] ; then
        echo "done: ${GUIREC_LAST}" > "${VRECORD_RECORD_STATUS_TMP}"
    else
        echo "idle" > "${VRECORD_RECORD_STATUS_TMP}"
    fi
}

# Video Preview tab / main page: run passthrough (or the audio check) as a
# separate vrecord process so the settings window stays open; the monitoring
# window opens separately and closing it (or pressing q) ends the passthrough;
# clicking the button again also stops it
_toggle_gui_passthrough(){ _gui_passthrough_toggle video ; }
_toggle_gui_audio_passthrough(){ _gui_passthrough_toggle audio ; }

_gui_passthrough_toggle(){
    if [ -f "${VRECORD_PASS_PID_TMP}" ] && kill -0 "$(cat "${VRECORD_PASS_PID_TMP}")" 2>/dev/null ; then
        _gui_passthrough_stop
        return 0
    fi
    _gui_passthrough_start "${1}"
}

_gui_passthrough_start(){
    # one capture device: a background recording owns it right now
    if [ -f "${VRECORD_RECORD_PID_TMP}" ] && kill -0 "$(cat "${VRECORD_RECORD_PID_TMP}")" 2>/dev/null ; then
        echo "a recording is in progress - stop it before passthrough" > "${VRECORD_FILEPLAY_STATUS_TMP}"
        echo "a recording is in progress - stop it before passthrough" > "${VRECORD_PASS_LOG_TMP}"
        return 1
    fi
    GP_INPUT="${DEVICE_INPUT_CHOICE}"
    if [ "${GP_INPUT}" = "4" ] ; then
        GP_INPUT="${INPUT_CHOICE_MEM}"
    fi
    if [ -z "${GP_INPUT}" ] || [ "${GP_INPUT}" = "3" ] ; then
        echo "select an input on the Decklink, DV, or Audio tab first" > "${VRECORD_FILEPLAY_STATUS_TMP}"
        echo "select an input on the Decklink, DV, or Audio tab first" > "${VRECORD_PASS_LOG_TMP}"
        return 1
    fi
    # the capture device and its output can only be opened by one process
    _stop_video_preview
    _stop_file_playback
    _update_config_file
    rm -f "${VRECORD_PASS_LOG_TMP}"
    if [ "${1}" = "audio" ] ; then
        GP_FLAG="-a"
        GP_LABEL="audio passthrough"
    else
        GP_FLAG="-p"
        GP_LABEL="passthrough"
    fi
    echo "starting ${GP_LABEL}..." > "${VRECORD_FILEPLAY_STATUS_TMP}"
    "${VRECORD_BIN}" "${GP_FLAG}" < /dev/null > "${VRECORD_PASS_LOG_TMP}" 2>&1 &
    echo $! > "${VRECORD_PASS_PID_TMP}"
}

# stop a passthrough started from the settings window by ending its monitoring
# window first (like closing it), so the capture pipeline unwinds cleanly and
# the landing state (input preview with relay) comes back
_gui_passthrough_stop(){
    if [ ! -f "${VRECORD_PASS_PID_TMP}" ] ; then
        return 0
    fi
    GP_PID="$(cat "${VRECORD_PASS_PID_TMP}")"
    if [ -n "${GP_PID}" ] && kill -0 "${GP_PID}" 2>/dev/null ; then
        # end the monitoring window first, like closing it in the classic flow
        GP_PLAYER="$(pgrep -P "${GP_PID}" ffplay-ma 2>/dev/null | head -n 1)"
        [ -z "${GP_PLAYER}" ] && GP_PLAYER="$(pgrep -P "${GP_PID}" ffplay 2>/dev/null | head -n 1)"
        [ -z "${GP_PLAYER}" ] && GP_PLAYER="$(pgrep -P "${GP_PID}" mpv 2>/dev/null | head -n 1)"
        if [ -n "${GP_PLAYER}" ] ; then
            kill "${GP_PLAYER}" 2>/dev/null
        fi
        # if the capture is still running shortly after, end it too
        GP_WAIT=0
        while [ "${GP_WAIT}" -lt 30 ] && kill -0 "${GP_PID}" 2>/dev/null ; do
            sleep 0.1
            GP_WAIT=$(( GP_WAIT + 1 ))
        done
        if kill -0 "${GP_PID}" 2>/dev/null ; then
            GP_FFMPEG="$(pgrep -P "${GP_PID}" ffmpeg-ma 2>/dev/null | head -n 1)"
            [ -z "${GP_FFMPEG}" ] && GP_FFMPEG="$(pgrep -P "${GP_PID}" ffmpeg 2>/dev/null | head -n 1)"
            [ -n "${GP_FFMPEG}" ] && kill "${GP_FFMPEG}" 2>/dev/null
        fi
    fi
    rm -f "${VRECORD_PASS_PID_TMP}"
    # restore the landing state unless a file playout owns the output
    if ! { [ -f "${VRECORD_FILEPLAY_PID_TMP}" ] && kill -0 "$(cat "${VRECORD_FILEPLAY_PID_TMP}")" 2>/dev/null ; } ; then
        _start_video_preview
    fi
}

# Video Preview tab: keep the passthrough state in sync; when a passthrough
# ends (monitoring window closed or q pressed), reset like a recording ends
_refresh_gui_passthrough_status(){
    if [ ! -f "${VRECORD_PASS_PID_TMP}" ] ; then
        return 0
    fi
    GP_PID="$(cat "${VRECORD_PASS_PID_TMP}")"
    if [ -n "${GP_PID}" ] && kill -0 "${GP_PID}" 2>/dev/null ; then
        return 0
    fi
    # the passthrough finished: clear the state so a new one can start
    rm -f "${VRECORD_PASS_PID_TMP}"
    if ! { [ -f "${VRECORD_FILEPLAY_PID_TMP}" ] && kill -0 "$(cat "${VRECORD_FILEPLAY_PID_TMP}")" 2>/dev/null ; } ; then
        _start_video_preview
    fi
}

# Video Preview tab: start the recording in a terminal window (classic vrecord
# style) while the settings window stays open with its controls
_popout_recording(){
    if [ -f "${VRECORD_RECORD_PID_TMP}" ] && kill -0 "$(cat "${VRECORD_RECORD_PID_TMP}")" 2>/dev/null ; then
        echo "already recording from this window" > "${VRECORD_RECORD_STATUS_TMP}"
        return 0
    fi
    if [ -z "${ID}" ] ; then
        echo "enter a Name of Recording first" > "${VRECORD_RECORD_STATUS_TMP}"
        return 1
    fi
    GUIREC_INPUT="${DEVICE_INPUT_CHOICE}"
    if [ "${GUIREC_INPUT}" = "4" ] ; then
        GUIREC_INPUT="${INPUT_CHOICE_MEM}"
    fi
    if [ -z "${GUIREC_INPUT}" ] || [ "${GUIREC_INPUT}" = "3" ] ; then
        echo "select an input on the Decklink, DV, or Audio tab first" > "${VRECORD_RECORD_STATUS_TMP}"
        return 1
    fi
    _stop_video_preview
    _stop_file_playback
    _update_config_file
    if command -v gnome-terminal >/dev/null 2>&1 ; then
        GUIREC_TERM="gnome-terminal --"
    elif command -v mate-terminal >/dev/null 2>&1 ; then
        GUIREC_TERM="mate-terminal --"
    elif command -v konsole >/dev/null 2>&1 ; then
        GUIREC_TERM="konsole -e"
    elif command -v xterm >/dev/null 2>&1 ; then
        GUIREC_TERM="xterm -e"
    else
        echo "no terminal emulator found - use Record instead" > "${VRECORD_RECORD_STATUS_TMP}"
        return 1
    fi
    VRECORD_BIN="${VRECORD_BIN}" VRECORD_ID="${ID}" ${GUIREC_TERM} bash -c '"${VRECORD_BIN}" "${VRECORD_ID}" ; echo "" ; echo "vrecord finished - press Enter to close" ; read VRECORD_CLOSE' &
    echo "popped out to a terminal window - this window stays open" > "${VRECORD_RECORD_STATUS_TMP}"
}

# Video Preview tab: stop a background preview/playback process
# (SIGTERM with a short grace period, then SIGKILL, so the device is always released)
_stop_bg_process(){
    if [ -f "${1}" ] ; then
        BG_PID="$(cat "${1}")"
        if [ -n "${BG_PID}" ] && kill -0 "${BG_PID}" 2>/dev/null ; then
            kill "${BG_PID}" 2>/dev/null
            BG_WAIT=0
            while [ "${BG_WAIT}" -lt 30 ] && kill -0 "${BG_PID}" 2>/dev/null ; do
                sleep 0.1
                BG_WAIT=$(( BG_WAIT + 1 ))
            done
            if kill -0 "${BG_PID}" 2>/dev/null ; then
                kill -9 "${BG_PID}" 2>/dev/null
            fi
        fi
        rm -f "${1}"
    fi
    echo "stopped" > "${2}"
}

# instant stop for preview/playout processes: they write no files, so there is
# nothing to finalize and SIGKILL is exact (ffmpeg ignores SIGTERM for seconds
# while blocked on the decklink output, which made stops and pauses hold the
# wrong position)
_kill_bg_process(){
    if [ -f "${1}" ] ; then
        BG_PID="$(cat "${1}")"
        if [ -n "${BG_PID}" ] ; then
            kill -9 "${BG_PID}" 2>/dev/null
        fi
        rm -f "${1}"
    fi
    echo "stopped" > "${2}"
}

_stop_video_preview(){
    _kill_bg_process "${VRECORD_PREVIEW_PID_TMP}" "${VRECORD_PREVIEW_STATUS_TMP}"
    if [ -f "${VRECORD_PREVIEW_RPID_TMP}" ] ; then
        kill "$(cat "${VRECORD_PREVIEW_RPID_TMP}")" 2>/dev/null
        rm -f "${VRECORD_PREVIEW_RPID_TMP}"
    fi
    rm -f "${VRECORD_PREVIEW_FIFO}" "${VRECORD_PREVIEW_TMP}.frame" "${VRECORD_PREVIEW_TMP}.new" "${VRECORD_PREVIEW_TMP}.tmp" 2>/dev/null
    _write_black_ppm "${VRECORD_PREVIEW_TMP}"
    if [ "$(readlink "${VRECORD_OUTPUT_DISPLAY_TMP}" 2>/dev/null)" = "${VRECORD_PREVIEW_TMP}" ] ; then
        _write_black_ppm "${VRECORD_OUTPUT_DISPLAY_TMP}"
    fi
}

# stop the file playout without clearing the cued position (used by the scrub bar)
_halt_file_playback(){
    _kill_bg_process "${VRECORD_FILEPLAY_PID_TMP}" "${VRECORD_FILEPLAY_STATUS_TMP}"
    if [ -f "${VRECORD_FILEPLAY_RPID_TMP}" ] ; then
        kill "$(cat "${VRECORD_FILEPLAY_RPID_TMP}")" 2>/dev/null
        rm -f "${VRECORD_FILEPLAY_RPID_TMP}"
    fi
    rm -f "${VRECORD_FILEPLAY_FIFO}" "${VRECORD_FILEPLAY_IMG_TMP}.frame" "${VRECORD_FILEPLAY_IMG_TMP}.new" "${VRECORD_FILEPLAY_IMG_TMP}.tmp" 2>/dev/null
    if [ "$(readlink "${VRECORD_OUTPUT_DISPLAY_TMP}" 2>/dev/null)" = "${VRECORD_FILEPLAY_IMG_TMP}" ] ; then
        _write_black_ppm "${VRECORD_OUTPUT_DISPLAY_TMP}"
    fi
}

_stop_file_playback(){
    _halt_file_playback
    rm -f "${VRECORD_PLAY_POS_TMP}" "${VRECORD_PLAY_OFFSET_TMP}"
}

# Video Preview tab: one combined status refresh for the slow status timer
_refresh_preview_page(){
    _refresh_video_preview_status
    # passthrough refresh first: a just-ended passthrough resets within the
    # same tick so the output pane never shows a stale "passthrough running"
    _refresh_gui_passthrough_status
    _refresh_file_playback_status
    _refresh_gui_recording_status
}

# Video Preview tab: keep a status display in sync with a background preview/playback process
_refresh_bg_status(){
    if [ -f "${1}" ] ; then
        BG_PID="$(cat "${1}")"
        if [ -n "${BG_PID}" ] && kill -0 "${BG_PID}" 2>/dev/null ; then
            echo "${4} (pid ${BG_PID})" > "${3}"
            return 0
        fi
    fi
    # process never started this session: keep any start-guard message instead
    # of overwriting it with "stopped"
    if [ ! -f "${2}" ] ; then
        return 0
    fi
    BG_LASTLINE="$(tail -n 1 "${2}" 2>/dev/null)"
    if [ -n "${BG_LASTLINE}" ] ; then
        echo "stopped: ${BG_LASTLINE}" > "${3}"
    else
        echo "stopped" > "${3}"
    fi
}

_refresh_video_preview_status(){
    _refresh_bg_status "${VRECORD_PREVIEW_PID_TMP}" "${VRECORD_PREVIEW_LOG_TMP}" "${VRECORD_PREVIEW_STATUS_TMP}" "running"
}

_refresh_file_playback_status(){
    # the test signal owns the output status line while it runs
    if [ -f "${VRECORD_TEST_PID_TMP}" ] && kill -0 "$(cat "${VRECORD_TEST_PID_TMP}")" 2>/dev/null ; then
        echo "test signal (bars + tone) playing" > "${VRECORD_FILEPLAY_STATUS_TMP}"
        return 0
    fi
    FP_DUR="$(cat "${VRECORD_FILEPLAY_DUR_TMP}" 2>/dev/null)"
    FP_DURHMS=""
    if [ -n "${FP_DUR}" ] ; then
        FP_DURHMS="$(awk -v s="${FP_DUR}" 'BEGIN { printf "%02d:%02d:%02d", int(s/3600), int((s%3600)/60), int(s%60) }')"
    fi
    FP_STATTIME="$(tail -c 4096 "${VRECORD_FILEPLAY_LOG_TMP}" 2>/dev/null | grep -o 'time=[0-9:.]*' | tail -n 1 | cut -d= -f2)"
    if [ -n "${FP_STATTIME}" ] ; then
        FP_TIME="$(_fp_abs_time "${FP_STATTIME}")"
    else
        FP_TIME=""
    fi
    if [ -f "${VRECORD_FILEPLAY_PID_TMP}" ] ; then
        BG_PID="$(cat "${VRECORD_FILEPLAY_PID_TMP}")"
        if [ -n "${BG_PID}" ] && kill -0 "${BG_PID}" 2>/dev/null ; then
            # only track the position while the playback process is alive
            if [ -n "${FP_TIME}" ] ; then
                echo "${VRECORD_PLAY_FILE}|${FP_TIME}" > "${VRECORD_PLAY_POS_TMP}"
            fi
            echo "playing ${FP_TIME:-00:00:00.00}${FP_DURHMS:+ / ${FP_DURHMS}}" > "${VRECORD_FILEPLAY_STATUS_TMP}"
            return 0
        fi
    fi
    # while a GUI passthrough runs, the output pane carries its state
    if [ -f "${VRECORD_PASS_PID_TMP}" ] ; then
        GP_PID="$(cat "${VRECORD_PASS_PID_TMP}")"
        if [ -n "${GP_PID}" ] && kill -0 "${GP_PID}" 2>/dev/null ; then
            echo "passthrough running - press q or click Passthrough to stop" > "${VRECORD_FILEPLAY_STATUS_TMP}"
            return 0
        fi
    fi
    # while the relay runs, the output pane carries the input feed
    if [ -f "${VRECORD_PREVIEW_PID_TMP}" ] && kill -0 "$(cat "${VRECORD_PREVIEW_PID_TMP}")" 2>/dev/null \
            && [ "${PREVIEW_RELAY_CHOICE}" = "true" ] ; then
        echo "relaying input feed to the output" > "${VRECORD_FILEPLAY_STATUS_TMP}"
        return 0
    fi
    # playout never started this session: keep any start-guard message instead
    # of overwriting it with "stopped" (the message explains why nothing ran)
    if [ ! -f "${VRECORD_FILEPLAY_LOG_TMP}" ] ; then
        return 0
    fi
    FP_POS="$(cat "${VRECORD_PLAY_POS_TMP}" 2>/dev/null)"
    if [ -n "${FP_POS}" ] && [ "$(echo "${FP_POS}" | cut -d'|' -f1)" = "${VRECORD_PLAY_FILE}" ] ; then
        FP_LAST="$(echo "${FP_POS}" | cut -d'|' -f2)"
        FP_LASTSEC="$(echo "${FP_LAST}" | awk -F: '{ if (NF==3) print $1*3600+$2*60+$3 ; else print $1 }')"
        if [ -n "${FP_DUR}" ] && [ "$(awk -v a="${FP_LASTSEC}" -v b="${FP_DUR}" 'BEGIN { print (a+0 >= b-0.05) ? 1 : 0 }')" = "1" ] ; then
            echo "finished${FP_DURHMS:+ (${FP_DURHMS})}" > "${VRECORD_FILEPLAY_STATUS_TMP}"
            return 0
        fi
        echo "paused at ${FP_LAST} - toggle Play to resume" > "${VRECORD_FILEPLAY_STATUS_TMP}"
        return 0
    fi
    FP_ERR="$(grep -vE '^frame=' "${VRECORD_FILEPLAY_LOG_TMP}" 2>/dev/null | tail -n 1)"
    if [ -n "${FP_ERR}" ] ; then
        echo "stopped: ${FP_ERR}" > "${VRECORD_FILEPLAY_STATUS_TMP}"
    else
        echo "stopped" > "${VRECORD_FILEPLAY_STATUS_TMP}"
    fi
}

# combine the HH/MM/SS recording time boxes into DURATION (POSIX; all boxes blank means an unlimited recording)
