    # fifo output branch tests PREVIEW_READER, and building the args first
    # left it unset, capping the preview (and by backpressure the whole
    # playout, the decklink output included) at the 15 fps fallback rate
    _ensure_preview_reader
    set -- "${FFMPEG_BIN}" -nostdin -nostats -loglevel error -y -stats -stats_period 0.033 -re
    if [ -n "${FP_RESUME}" ] ; then
        set -- "$@" -ss "${FP_RESUME}"
    fi
    set -- "$@" -i "${VRECORD_PLAY_FILE}"
    # lossless preview of the outgoing file for the output side of the tab: raw RGB frames
    # through a fifo (same stream and timeline as the device output; scaled to the pane
    # because gtkdialog pixmaps render at natural size), wrapped in PPM atomically
    if [ -n "${PREVIEW_READER}" ] ; then
        set -- "$@" -map 0:v -vf scale=480:-2 -f rawvideo -pix_fmt rgb24 "${VRECORD_FILEPLAY_FIFO}"
    else
        set -- "$@" -map 0:v -vf "scale=480:-2,fps=15" -f rawvideo -pix_fmt rgb24 "${VRECORD_FILEPLAY_FIFO}"
    fi
    # feed to the device output: frame-level field marking (setfield) plus the
    # card's own mode autodetection. Passing an explicit format_code makes the
    # muxer validate the stream's container-level field order, which rawvideo
    # pipelines leave unset even when the frames are marked, and the whole
    # output is rejected with 'Unsupported video size, framerate or field order'
    if [ -n "${FP_VF}" ] ; then
        set -- "$@" -map 0:v -map "0:a?" -vf "${FP_VF}" -c:v v210 -c:a pcm_s16le -ar 48000 -ac 2 -f decklink "${FILEPLAY_DEV}"
    else
        set -- "$@" -map 0:v -map "0:a?" -c:v v210 -c:a pcm_s16le -ar 48000 -ac 2 -f decklink "${FILEPLAY_DEV}"
    fi
    _stop_video_preview
    _stop_test_signal
    # remember the seek offset: ffmpeg rebases its time= counter after -ss
    echo "${FP_RESUME:-00:00:00.00}" > "${VRECORD_PLAY_OFFSET_TMP}"
    rm -f "${VRECORD_FILEPLAY_IMG_TMP}" "${VRECORD_FILEPLAY_FIFO}"
    mkfifo "${VRECORD_FILEPLAY_FIFO}"
    FP_W=480
    FP_H="$(awk -v w="${FP_FW}" -v h="${FP_FH}" 'BEGIN { printf "%d", int(((480 * h / w) + 1) / 2) * 2 }')"
    if [ -n "${PREVIEW_READER}" ] ; then
        "${PREVIEW_READER}" "${VRECORD_FILEPLAY_FIFO}" "${VRECORD_FILEPLAY_IMG_TMP}" "${FP_W}" "${FP_H}" 1 > /dev/null 2>&1 &
    else
        FP_PIX=$(( FP_W * FP_H * 3 ))
        FPPIX="${FP_PIX}" FPW="${FP_W}" FPH="${FP_H}" FPDISP="${VRECORD_FILEPLAY_IMG_TMP}" \
            sh -c 'while head -c "${FPPIX}" > "${FPDISP}.frame" 2>/dev/null ; do
                      [ "$(wc -c < "${FPDISP}.frame")" = "${FPPIX}" ] || break
                      { printf "P6\n%s %s\n255\n" "${FPW}" "${FPH}" ; cat "${FPDISP}.frame" ; } > "${FPDISP}.new"
                      mv -f "${FPDISP}.new" "${FPDISP}"
                  done' < "${VRECORD_FILEPLAY_FIFO}" > /dev/null 2>&1 &
    fi
    echo $! > "${VRECORD_FILEPLAY_RPID_TMP}"
    if [ "${FP_AUTO}" = "true" ] ; then
        echo "playing ${VRECORD_PLAY_FILE}${FP_RESUME:+ from ${FP_RESUME}} (native ${FP_FW}x${FP_FH} @ ${FP_RATE_STR}${FP_FORMAT_CODE:+, mode ${FP_FORMAT_CODE}})" > "${VRECORD_FILEPLAY_STATUS_TMP}"
    else
        echo "playing ${VRECORD_PLAY_FILE}${FP_RESUME:+ from ${FP_RESUME}} (converted to ${STANDARD_CHOICE}${FP_FORMAT_CODE:+, mode ${FP_FORMAT_CODE}})" > "${VRECORD_FILEPLAY_STATUS_TMP}"
    fi
    "$@" > "${VRECORD_FILEPLAY_LOG_TMP}" 2>&1 &
    echo $! > "${VRECORD_FILEPLAY_PID_TMP}"
    # the output pane shows the playout feed while it runs
    ln -sf "${VRECORD_FILEPLAY_IMG_TMP}" "${VRECORD_OUTPUT_DISPLAY_TMP}"
}

# Video Preview tab: pause file playback, keeping the position for a later resume
_pause_file_playback(){
    FP_PAUSETIME=""
    FP_RUNNING="false"
    if [ -f "${VRECORD_FILEPLAY_PID_TMP}" ] && kill -0 "$(cat "${VRECORD_FILEPLAY_PID_TMP}")" 2>/dev/null ; then
        FP_RUNNING="true"
        # parse the freshest stats line so the pause lands on the frame being shown,
        # adding back the seek offset because -ss rebases ffmpeg's time= counter
        FP_STATTIME="$(tail -c 4096 "${VRECORD_FILEPLAY_LOG_TMP}" 2>/dev/null | grep -o 'time=[0-9:.]*' | tail -n 1 | cut -d= -f2)"
        if [ -n "${FP_STATTIME}" ] ; then
            FP_PAUSETIME="$(_fp_abs_time "${FP_STATTIME}")"
        fi
    fi
    if [ -z "${FP_PAUSETIME}" ] ; then
        FP_POS="$(cat "${VRECORD_PLAY_POS_TMP}" 2>/dev/null)"
        if [ -n "${FP_POS}" ] && [ "$(echo "${FP_POS}" | cut -d'|' -f1)" = "${VRECORD_PLAY_FILE}" ] ; then
            FP_PAUSETIME="$(echo "${FP_POS}" | cut -d'|' -f2)"
        fi
    fi
    if [ "${FP_RUNNING}" != "true" ] && [ -z "${FP_PAUSETIME}" ] ; then
        echo "not playing" > "${VRECORD_FILEPLAY_STATUS_TMP}"
        return 0
    fi
    # instant kill so the playout stops on the exact parsed frame (ffmpeg ignores
    # SIGTERM for seconds while blocked on the decklink output)
    _halt_file_playback
    if [ -z "${FP_PAUSETIME}" ] ; then
        FP_PAUSETIME="00:00:00.00"
    fi
    echo "${VRECORD_PLAY_FILE}|${FP_PAUSETIME}" > "${VRECORD_PLAY_POS_TMP}"
    echo "paused at ${FP_PAUSETIME} - toggle Play to resume" > "${VRECORD_FILEPLAY_STATUS_TMP}"
}

# Video Preview tab: scrub bar handler - seeks the file playback to a frame
# number (the slider ranges 0..total frames once the file has been probed)
_seek_frame_playback(){
    FP_FRAME="${FILEPLAY_SEEK}"
    if ! echo "${FP_FRAME}" | grep -qE '^[0-9]+$' ; then
        return 1
    fi
    FP_FPS="$(cat "${VRECORD_FILEPLAY_FPS_TMP}" 2>/dev/null)"
    FP_DUR="$(cat "${VRECORD_FILEPLAY_DUR_TMP}" 2>/dev/null)"
    if [ -z "${FP_FPS}" ] || [ -z "${FP_DUR}" ] ; then
        echo "frame range unknown - play the file once first" > "${VRECORD_FILEPLAY_STATUS_TMP}"
        return 1
    fi
    FP_SEC="$(awk -v f="${FP_FRAME}" -v r="${FP_FPS}" 'BEGIN { printf "%.3f", f / r }')"
    if awk -v s="${FP_SEC}" -v d="${FP_DUR}" 'BEGIN { exit (s > d) ? 0 : 1 }' ; then
        FP_SEC="${FP_DUR}"
    fi
    FP_HMS="$(awk -v s="${FP_SEC}" 'BEGIN { printf "%02d:%02d:%06.3f", int(s/3600), int((s%3600)/60), s%60 }')"
    echo "${VRECORD_PLAY_FILE}|${FP_HMS}" > "${VRECORD_PLAY_POS_TMP}"
    echo "frame ${FP_FRAME}" > "${VRECORD_FILEPLAY_FRAME_TMP}"
    if [ -f "${VRECORD_FILEPLAY_PID_TMP}" ] && kill -0 "$(cat "${VRECORD_FILEPLAY_PID_TMP}")" 2>/dev/null ; then
        _halt_file_playback
        _start_file_playback
    else
        echo "cued at frame ${FP_FRAME} (${FP_HMS}) - toggle Play to start there" > "${VRECORD_FILEPLAY_STATUS_TMP}"
    fi
}

