+/* --- vrecord instrumentation (env-gated, no-op unless GTKDIALOG_ACTION_LOG set) --- */
+static void vd_action_log(const char *tag, const char *cmd, long dur_us)
+{
+	const char *path = g_getenv("GTKDIALOG_ACTION_LOG");
+	FILE *f;
+	gint64 now;
+
+	if (path == NULL || *path == '\0')
+		return;
+	f = fopen(path, "a");
+	if (f == NULL)
+		return;
+	now = g_get_real_time();
+	fprintf(f, "%ld.%06ld %s %7ldus %s\n",
+		(long)(now / G_USEC_PER_SEC), (long)(now % G_USEC_PER_SEC),
+		tag, dur_us, cmd ? cmd : "(null)");
+	fclose(f);
+}
+
+
 int gtkdialog_parse(void);
 
