+/* vrecord Windows port: real getline (the stub returned 0 without touching
+ * *lineptr and callers dereferenced it -> segfault with --file=) */
 ssize_t
 getline(char **lineptr, size_t *n, FILE *stream)
 {
-	g_warning("%s(): Unimplemented", __func__);
-	return 0;
+	size_t cap = (*n && *lineptr) ? *n : 128;
+	size_t len = 0;
+	int ch;
+
+	if (*lineptr == NULL)
+		*lineptr = g_malloc(cap);
+	else if (*n < 128)
+		cap = *n = 128;
+
+	while ((ch = fgetc(stream)) != EOF) {
+		if (len + 2 > cap) {
+			cap *= 2;
+			*lineptr = g_realloc(*lineptr, cap);
+			*n = cap;
+		}
+		(*lineptr)[len++] = (char) ch;
+		if (ch == '\n')
+			break;
+	}
+	if (len == 0 && ch == EOF)
+		return -1;
+	(*lineptr)[len] = '\0';
+	*n = cap;
+	return (ssize_t) len;
 }
 #endif
 
