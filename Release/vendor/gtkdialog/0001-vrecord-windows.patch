+/* pclose() replacement for widget_opencommand streams: close + reap + status */
+gint widget_pclose(FILE *f)
+{
+	HANDLE proc;
+	gint ret = -1;
+
+	if (f == NULL)
+		return -1;
+	proc = (vd_pipe_procs != NULL)
+		? (HANDLE) g_hash_table_lookup(vd_pipe_procs, f)
+		: NULL;
+	fclose(f);
+	if (proc != NULL) {
+		DWORD code = 0;
+		WaitForSingleObject(proc, INFINITE);
+		GetExitCodeProcess(proc, &code);
+		CloseHandle(proc);
+		g_hash_table_remove(vd_pipe_procs, f);
+		ret = (gint) code;
+	}
+	return ret;
+}
